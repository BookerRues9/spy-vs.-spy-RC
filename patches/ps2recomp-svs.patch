+    // Byte offsets inside one 8 KB page of every pixel of a 64x32 page, for the 32-bit
+    // layouts (PSMCT32/24 and PSMZ32/24), built once from the per-pixel writers. Rect
+    // reads/writes of page-aligned buffers then avoid a function call and the page math
+    // per pixel (the GPU renderer moves whole render targets through these).
+    struct SvsPage32
+    {
+        uint16_t off[32][64];
+        bool ready = false;
+    };
+    SvsPage32 s_svsPageC32, s_svsPageZ32;
+    std::mutex s_svsPageMutex;
+    const SvsPage32 *svsPage32(uint32_t psm)
+    {
+        const bool z = (psm & 0x30u) == 0x30u;
+        if (psm != 0u && psm != 1u && psm != 0x30u && psm != 0x31u)
+            return nullptr;
+        SvsPage32 &t = z ? s_svsPageZ32 : s_svsPageC32;
+        if (t.ready)
+            return &t;
+        std::lock_guard<std::mutex> lock(s_svsPageMutex);
+        if (!t.ready)
+        {
+            std::vector<uint8_t> scratch(8192u * 4u, 0u);
+            for (uint32_t y = 0; y < 32u; ++y)
+                for (uint32_t x = 0; x < 64u; ++x)
+                {
+                    std::fill(scratch.begin(), scratch.begin() + 8192, 0u);
+                    if (z)
+                        GSMem::WriteZ32(scratch.data(), 0u, 1u, x, y, 0xFFFFFFFFu);
+                    else
+                        GSMem::WriteCT32(scratch.data(), 0u, 1u, x, y, 0xFFFFFFFFu);
+                    for (uint32_t o = 0; o < 8192u; o += 4u)
+                        if (scratch[o] == 0xFFu)
+                        {
+                            t.off[y][x] = static_cast<uint16_t>(o);
+                            break;
+                        }
+                }
+            t.ready = true;
+        }
+        return &t;
+    }
