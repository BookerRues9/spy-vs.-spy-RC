@@ -0,0 +1,40 @@
+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+
+#include <memory>
+
+// OpenGL 3.3 renderer for the GS ("dibujar con la gráfica").
+//
+// The CPU backend stays the owner of the 4 MB of GS local memory (uploads, CLUTs,
+// transfers, readbacks and presentation still go through it). Drawing happens on the
+// GPU: every frame/Z buffer the game draws into becomes a GL texture ("target"), and
+// the rendered pixels are only copied back to local memory when something has to read
+// them (display, texture in a format the GPU cannot reinterpret, transfers).
+//
+// All GL work runs on one thread with its own context, shared with the window's.
+// SVS_RENDERER=cpu goes back to the software rasterizer.
+std::unique_ptr<GSRasterBackend> svsMakeGLBackend();
+
+// Main thread, right after the window exists: creates the hidden context shared with
+// the window's so the GS thread can render. Returns false if it could not.
+bool svsGlCreateSharedContext();
+bool svsGlRendererActive();
+void svsGlVSyncThrottle();
+
+// Single-context mode (default): the GPU renderer runs on the window's own GL context,
+// on the window (main) thread. Some drivers (Intel on Windows) corrupt the window when a
+// second GL context renders at the same time. SVS_GL_THREAD=1 brings back the separate
+// renderer thread with its own context.
+bool svsGlMainThreadMode();
+// Main thread: run queued GPU work, waiting for more for up to `waitSeconds`
+// (0 = only what is queued now).
+void svsGlPump(double waitSeconds);
+// Main thread waiting for a lock: run a bit of queued GPU work. Returns false when this
+// thread is not the renderer (the caller should just block).
+bool svsGlPumpWhileBlocked();
+// Single-context mode: the last presented picture is a GPU texture (no CPU copy).
+// texW/texH: texture size; w/h: the picture inside it (top-left).
+bool svsGlDirectFrame(unsigned &tex, int &texW, int &texH, int &w, int &h);
+// Before joining the game thread at exit: stop waiting for the renderer.
+void svsGlStop();
