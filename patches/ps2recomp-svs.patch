+void GSCpuBackend::DecodeTextureRgba(const GSDrawState &state, uint32_t w, uint32_t h, uint32_t *out)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const auto &tex = state.context.tex0;
+    const bool indexed = tex.psm == GS_PSM_T8 || tex.psm == GS_PSM_T8H || tex.psm == GS_PSM_T4 ||
+                         tex.psm == GS_PSM_T4HL || tex.psm == GS_PSM_T4HH;
+    if (indexed)
+    {
+        // palette resolved once, then one table lookup per texel
+        uint32_t palette[256];
+        const uint32_t n = isFourBitIndexedPsm(tex.psm) ? 16u : 256u;
+        for (uint32_t i = 0; i < n; ++i)
+            palette[i] = LookupCLUT(state, static_cast<u8>(i), tex.cpsm, tex.csm, tex.csa, tex.psm);
+        const uint32_t mask = n - 1u;
+        for (uint32_t y = 0; y < h; ++y)
+        {
+            uint32_t *row = out + static_cast<size_t>(y) * w;
+            for (uint32_t x = 0; x < w; ++x)
+                row[x] = palette[ReadTextureVramUnlocked(tex.psm, tex.tbp0, tex.tbw, x, y) & mask];
+        }
+        return;
+    }
+    for (uint32_t y = 0; y < h; ++y)
+    {
+        uint32_t *row = out + static_cast<size_t>(y) * w;
+        for (uint32_t x = 0; x < w; ++x)
+        {
+            const u32 raw = ReadTextureVramUnlocked(tex.psm, tex.tbp0, tex.tbw, x, y);
+            u32 c;
+            switch (tex.psm)
+            {
+            case GS_PSM_CT32:
+            case GS_PSM_Z32:
+            case GS_PSM_CT24:
+            case GS_PSM_Z24:
+                c = applyTexa(state.texa, tex.psm, raw);
+                break;
+            case GS_PSM_CT16:
+            case GS_PSM_CT16S:
+            case GS_PSM_Z16:
+            case GS_PSM_Z16S:
+                c = applyTexa(state.texa, tex.psm, Rgba5551ToRgba8888(static_cast<u16>(raw)));
+                break;
+            case GS_PSM_T8:
+            case GS_PSM_T8H:
+            case GS_PSM_T4:
+            case GS_PSM_T4HL:
+            case GS_PSM_T4HH:
+                c = LookupCLUT(state, static_cast<u8>(raw), tex.cpsm, tex.csm, tex.csa, tex.psm);
+                break;
+            default:
+                c = 0xFFFF00FFu;
+                break;
+            }
+            row[x] = c;
+        }
+    }
+}
