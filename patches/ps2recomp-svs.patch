+        s_svsAotByPc[pr.entry >> 3] = static_cast<int16_t>(k); // a program is preferred at its own entry
+        s_svsAotAny = true;
+    }
+    for (uint32_t k = 0; k < svsaot::kProgCount; ++k)
+    {
+        if (!s_svsAotMatched[k])
+            continue;
+        const svsaot::Prog &pr = svsaot::kProgs[k];
+        for (uint32_t i = 0; i < pr.count; ++i)
+        {
+            int16_t &slot = s_svsAotByPc[pr.sig[i * 3] >> 3];
+            if (slot < 0)
+                slot = static_cast<int16_t>(k);
+        }
+    }
+    static const bool tr = std::getenv("SVS_AOT_TRACE") != nullptr;
+    if (tr)
+    {
+        uint32_t n = 0;
+        for (auto k : s_svsAotByPc)
+            n += k >= 0 ? 1u : 0u;
+        std::fprintf(stderr, "[vu-aot] rebind: %u pares cubiertos\n", n);
+    }
+}
+static int svsAotRun(VU1Interpreter &v, uint8_t *vuData, uint32_t dataSize, GS &gs, PS2Memory *memory, uint64_t budgetEnd)
+{
+    if (!s_svsAotAny || (v.m_state.pc & 7u) != 0u)
+        return 0;
+    const int16_t k = s_svsAotByPc[(v.m_state.pc & 0x3FFFu) >> 3];
+    static const bool tr = std::getenv("SVS_AOT_TRACE") != nullptr;
+    if (tr)
+    {
+        static uint64_t hit = 0, miss = 0;
+        (k < 0 ? miss : hit)++;
+        static std::map<uint32_t, uint64_t> missPc;
+        if (k < 0 && ++missPc[v.m_state.pc] && ((miss % 50000u) == 0u))
+            for (auto &kv : missPc)
+                if (kv.second > 1000u)
+                    std::fprintf(stderr, "[vu-aot] miss pc=0x%x x%llu fresh=%d\n", kv.first, (unsigned long long)kv.second, (int)s_svsFreshStart);
+        if (((hit + miss) % 20000u) == 0u)
+            std::fprintf(stderr, "[vu-aot] hit=%llu miss=%llu (pc=0x%x) aotInstr=%llu exits=%llu/%llu/%llu\n", (unsigned long long)hit, (unsigned long long)miss, v.m_state.pc, (unsigned long long)g_svsAotInstr, (unsigned long long)g_svsAotExit[0], (unsigned long long)g_svsAotExit[1], (unsigned long long)g_svsAotExit[2]);
+    }
+    if (k < 0)
+        return 0;
+    int r = svsaot::kProgs[k].fn(v, vuData, dataSize, gs, memory, budgetEnd);
+    // a jump out of one compiled program may land inside another one
+    for (int hop = 0; r == 0 && hop < 64; ++hop)
+    {
+        if ((v.m_state.pc & 7u) != 0u)
+            break;
+        const int16_t k2 = s_svsAotByPc[(v.m_state.pc & 0x3FFFu) >> 3];
+        if (k2 < 0)
+            break;
+        r = svsaot::kProgs[k2].fn(v, vuData, dataSize, gs, memory, budgetEnd);
+    }
+    return r;
+}
+#else
+static void svsAotRebind(const uint8_t *, uint32_t) {}
+static int svsAotRun(VU1Interpreter &, uint8_t *, uint32_t, GS &, PS2Memory *, uint64_t) { return 0; }
+#endif
+
+// ---- decoded-image cache (VU1, fast mode)
+namespace
+{
+    struct SvsImageCacheEntry
+    {
+        bool valid = false;
+        uint64_t hash = 0, lastUse = 0;
+        uint32_t size = 0, pairCount = 0;
+        std::vector<uint8_t> code;
+        std::vector<VU1Interpreter::DecodedInstructionPair> decoded;
+        std::vector<SvsPairTiming> timing;
+        std::vector<uint8_t> pairFlags;
+        std::vector<svsfast::FP> fp;
+        bool flagsLive = true;
+        std::vector<int16_t> aotByPc;
+        std::vector<uint8_t> aotMatched;
+        bool aotAny = false;
+    };
+    SvsImageCacheEntry s_svsImageCache[12];
+    uint64_t s_svsImageClock = 0;
+}
+
+static bool svsImageCacheRestore(VU1Interpreter &v, const uint8_t *code, uint32_t size, uint64_t hash, uint32_t pairCount)
+{
+    for (SvsImageCacheEntry &e : s_svsImageCache)
+    {
+        if (!e.valid || e.hash != hash || e.size != size || e.pairCount != pairCount || std::memcmp(e.code.data(), code, size) != 0)
+            continue;
+        e.lastUse = ++s_svsImageClock;
+        std::copy(e.decoded.begin(), e.decoded.end(), v.m_decodedCodeCache.begin());
+        std::copy(e.timing.begin(), e.timing.end(), s_svsTiming[1]);
+        for (uint32_t i = 0; i < pairCount; ++i)
+            s_svsPairFlags[1][i] = e.pairFlags[i] != 0u;
+        std::copy(e.fp.begin(), e.fp.end(), svsfast::s_fp);
+        svsfast::s_fpValid = true;
+        s_svsFlagsLive[1] = e.flagsLive;
+        s_svsTimingValid[1] = true;
+        s_svsCodeHash[1] = hash;
+#if __has_include("svs_vu1_aot.inc") && !defined(SVS_NO_AOT)
+        std::copy(e.aotByPc.begin(), e.aotByPc.end(), s_svsAotByPc);
+        for (uint32_t k = 0; k < svsaot::kProgCount; ++k)
+            s_svsAotMatched[k] = e.aotMatched[k] != 0u;
+        s_svsAotAny = e.aotAny;
+#endif
+        return true;
+    }
+    return false;
+}
+
+static void svsImageCacheStore(VU1Interpreter &v, const uint8_t *code, uint32_t size, uint64_t hash, uint32_t pairCount)
+{
+    SvsImageCacheEntry *slot = &s_svsImageCache[0];
+    for (SvsImageCacheEntry &e : s_svsImageCache)
+    {
+        if (!e.valid)
+        {
+            slot = &e;
+            break;
+        }
+        if (e.lastUse < slot->lastUse)
+            slot = &e;
+    }
+    SvsImageCacheEntry &e = *slot;
+    e.valid = true;
+    e.hash = hash;
+    e.size = size;
+    e.pairCount = pairCount;
+    e.lastUse = ++s_svsImageClock;
+    e.code.assign(code, code + size);
+    e.decoded.assign(v.m_decodedCodeCache.begin(), v.m_decodedCodeCache.begin() + pairCount);
+    e.timing.assign(s_svsTiming[1], s_svsTiming[1] + pairCount);
+    e.pairFlags.resize(pairCount);
+    for (uint32_t i = 0; i < pairCount; ++i)
+        e.pairFlags[i] = s_svsPairFlags[1][i] ? 1u : 0u;
+    e.fp.assign(svsfast::s_fp, svsfast::s_fp + pairCount);
+    e.flagsLive = s_svsFlagsLive[1];
+#if __has_include("svs_vu1_aot.inc") && !defined(SVS_NO_AOT)
+    e.aotByPc.assign(s_svsAotByPc, s_svsAotByPc + (0x4000u / 8u));
+    e.aotMatched.resize(svsaot::kProgCount);
+    for (uint32_t k = 0; k < svsaot::kProgCount; ++k)
+        e.aotMatched[k] = s_svsAotMatched[k] ? 1u : 0u;
+    e.aotAny = s_svsAotAny;
+#endif
+}
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_fast.inc b/ps2xRuntime/src/lib/vu/ps2_vu1_fast.inc
new file mode 100644
index 0000000..c0b4e2a
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_fast.inc
@@ -0,0 +1,767 @@
+// Fast VU1 executor ("svs fast path"). Included at the end of ps2_vu1_core.cpp.
+//
+// The interpreter loop decodes nothing at run time already (decoded-pair cache), but
+// every instruction still goes through the generic execUpper/execLower switches,
+// copies and clamps three whole vectors, and walks a lot of bookkeeping. Here every
+// pair of the code image is pre-translated once (when the code changes) into two
+// specialised handlers with their operands extracted, and the loop keeps only what
+// fast mode needs. Semantics are the interpreter's, case by case:
+//   * operands are normalised exactly like execUpper (denormal -> 0, Inf/NaN -> max),
+//   * FMAC results are clamped like applyFmacDest when the pair's flags are dead,
+//   * pairs whose MAC/status flags can be observed, rare ops, I-bit/shadowed pairs and
+//     anything unusual call the interpreter's own execUpper/execLower.
+// SVS_VU_FASTPATH=0 disables it; SVS_VU_CHECK=1 runs every fast upper/lower op twice
+// (fast and interpreter) and reports any difference.
+
+namespace svsfast
+{
+    using VU = VU1Interpreter;
+    struct FP;
+    using UpFn = void (*)(VU &, const FP &);
+    using LoFn = void (*)(VU &, const FP &, uint8_t *, uint32_t);
+
+    enum : uint16_t
+    {
+        F_IBIT = 1,
+        F_EBIT = 2,
+        F_DBIT = 4,
+        F_TBIT = 8,
+        F_BRANCH = 16,
+        F_SHADOW = 32,
+        F_RESERVED = 64,
+        F_DELAYBR = 128,
+        F_UPFAST = 256,
+        F_LOGENERIC = 512,
+        F_NOLOWER = 1024,
+    };
+
+    struct FP
+    {
+        UpFn up = nullptr;
+        LoFn lo = nullptr;
+        uint32_t upper = 0, lower = 0;
+        uint16_t flags = 0;
+        uint8_t dest = 0, fd = 0, fs = 0, ft = 0, bc = 0;
+        uint8_t ldest = 0, lft = 0, lfs = 0, vit = 0, vis = 0, vid = 0;
+        uint8_t viw = 0; // VI register written by the lower op (0 = none)
+        int16_t imm = 0;
+    };
+
+    static FP s_fp[0x4000u / 8u];
+    static bool s_fpValid = false;
+
+    static inline uint32_t clb(uint32_t b)
+    {
+        const uint32_t e = b & 0x7F800000u;
+        const uint32_t s = b & 0x80000000u;
+        return e == 0u ? s : (e == 0x7F800000u ? (s | 0x7F7FFFFFu) : b);
+    }
+    static inline float clf(float f)
+    {
+        uint32_t b;
+        std::memcpy(&b, &f, 4);
+        b = clb(b);
+        std::memcpy(&f, &b, 4);
+        return f;
+    }
+    static inline void ld4(float *o, const float *in)
+    {
+        uint32_t b[4];
+        std::memcpy(b, in, 16);
+        b[0] = clb(b[0]);
+        b[1] = clb(b[1]);
+        b[2] = clb(b[2]);
+        b[3] = clb(b[3]);
+        std::memcpy(o, b, 16);
+    }
+    static inline void st4(float *d, const float *r, uint8_t dest)
+    {
+        if (dest == 0xFu)
+        {
+            std::memcpy(d, r, 16);
+            return;
+        }
+        if (dest & 8u)
+            d[0] = r[0];
+        if (dest & 4u)
+            d[1] = r[1];
+        if (dest & 2u)
+            d[2] = r[2];
+        if (dest & 1u)
+            d[3] = r[3];
+    }
+
+    enum Fam
+    {
+        ADD,
+        SUB,
+        MUL,
+        MADD,
+        MSUB,
+        MAX,
+        MINI
+    };
+    enum Src
+    {
+        VT,
+        BCS,
+        QS,
+        IS
+    };
+
+    template <int FAM, int SRC, bool TOACC>
+    static void upArith(VU &v, const FP &p)
+    {
+        float s[4], t[4], r[4];
+        ld4(s, v.m_state.vf[p.fs]);
+        if (SRC == VT)
+            ld4(t, v.m_state.vf[p.ft]);
+        else
+        {
+            const float x = SRC == BCS ? clf(v.m_state.vf[p.ft][p.bc]) : (SRC == QS ? clf(v.m_state.q) : clf(v.m_state.i));
+            t[0] = t[1] = t[2] = t[3] = x;
+        }
+        if (FAM == MADD || FAM == MSUB)
+        {
+            float a[4];
+            ld4(a, v.m_state.acc);
+            for (int c = 0; c < 4; ++c)
+                r[c] = FAM == MADD ? a[c] + s[c] * t[c] : a[c] - s[c] * t[c];
+        }
+        else
+        {
+            for (int c = 0; c < 4; ++c)
+            {
+                if (FAM == ADD)
+                    r[c] = s[c] + t[c];
+                else if (FAM == SUB)
+                    r[c] = s[c] - t[c];
+                else if (FAM == MUL)
+                    r[c] = s[c] * t[c];
+                else if (FAM == MAX)
+                    r[c] = (s[c] > t[c]) ? s[c] : t[c];
+                else
+                    r[c] = (s[c] < t[c]) ? s[c] : t[c];
+            }
+        }
+        if (FAM != MAX && FAM != MINI)
+            ld4(r, r);
+        st4(TOACC ? v.m_state.acc : v.m_state.vf[p.fd], r, p.dest);
+    }
+
+    template <bool TOACC> // OPMULA (acc) / OPMSUB (fd)
+    static void upOuter(VU &v, const FP &p)
+    {
+        float s[4], t[4], r[4];
+        ld4(s, v.m_state.vf[p.fs]);
+        ld4(t, v.m_state.vf[p.ft]);
+        if (TOACC)
+        {
+            r[0] = s[1] * t[2];
+            r[1] = s[2] * t[0];
+            r[2] = s[0] * t[1];
+        }
+        else
+        {
+            float a[4];
+            ld4(a, v.m_state.acc);
+            r[0] = a[0] - s[1] * t[2];
+            r[1] = a[1] - s[2] * t[0];
+            r[2] = a[2] - s[0] * t[1];
+        }
+        r[3] = 0.0f;
+        ld4(r, r);
+        st4(TOACC ? v.m_state.acc : v.m_state.vf[p.fd], r, p.dest);
+    }
+
+    template <int K> // ITOF0/4/12/15
+    static void upItof(VU &v, const FP &p)
+    {
+        float r[4];
+        for (int c = 0; c < 4; ++c)
+        {
+            int32_t iv;
+            std::memcpy(&iv, &v.m_state.vf[p.fs][c], 4);
+            if (K == 0)
+                r[c] = static_cast<float>(iv);
+            else if (K == 1)
+                r[c] = static_cast<float>(iv) / 16.0f;
+            else if (K == 2)
+                r[c] = static_cast<float>(iv) / 4096.0f;
+            else
+                r[c] = static_cast<float>(iv) / 32768.0f;
+        }
+        st4(v.m_state.vf[p.ft], r, p.dest);
+    }
+
+    template <int K> // FTOI0/4/12/15
+    static void upFtoi(VU &v, const FP &p)
+    {
+        float s[4], r[4];
+        ld4(s, v.m_state.vf[p.fs]);
+        const float scale = K == 0 ? 1.0f : (K == 1 ? 16.0f : (K == 2 ? 4096.0f : 32768.0f));
+        for (int c = 0; c < 4; ++c)
+        {
+            const int32_t iv = vuFloatToInt(s[c], scale);
+            std::memcpy(&r[c], &iv, 4);
+        }
+        st4(v.m_state.vf[p.ft], r, p.dest);
+    }
+
+    static void upAbs(VU &v, const FP &p)
+    {
+        float s[4], r[4];
+        ld4(s, v.m_state.vf[p.fs]);
+        for (int c = 0; c < 4; ++c)
+            r[c] = std::fabs(s[c]);
+        st4(v.m_state.vf[p.ft], r, p.dest);
+    }
+
+    static void upNop(VU &, const FP &) {}
+
+    static void upGeneric(VU &v, const FP &p)
+    {
+        v.execUpper(p.upper);
+    }
+
+    // ---- lower
+    static void loNop(VU &, const FP &, uint8_t *, uint32_t) {}
+
+    static void loLQ(VU &v, const FP &p, uint8_t *data, uint32_t size)
+    {
+        uint32_t addr = (static_cast<uint32_t>(static_cast<int32_t>(v.m_state.vi[p.vis] + p.imm))) * 16u;
+        addr &= (size - 1u);
+        if (addr + 16u <= size)
+        {
+            float tmp[4];
+            std::memcpy(tmp, data + addr, 16);
+            st4(v.m_state.vf[p.lft], tmp, p.ldest);
+        }
+    }
+    static void loSQ(VU &v, const FP &p, uint8_t *, uint32_t size)
+    {
+        uint32_t addr = (static_cast<uint32_t>(static_cast<int32_t>(v.m_state.vi[p.vit] + p.imm))) * 16u;
+        addr &= (size - 1u);
+        if (addr + 16u <= size)
+        {
+            uint32_t words[4];
+            std::memcpy(words, v.m_state.vf[p.lfs], 16);
+            v.queueStore(addr, words, p.ldest);
+        }
+    }
+    static void loLQI(VU &v, const FP &p, uint8_t *data, uint32_t size)
+    {
+        uint32_t addr = (static_cast<uint32_t>(static_cast<uint16_t>(v.m_state.vi[p.vis]))) * 16u;
+        addr &= (size - 1u);
+        if (addr + 16u <= size)
+        {
+            float tmp[4];
+            std::memcpy(tmp, data + addr, 16);
+            st4(v.m_state.vf[p.lft], tmp, p.ldest);
+        }
+        if (p.vis != 0u)
+            v.m_state.vi[p.vis] = static_cast<int16_t>(v.m_state.vi[p.vis] + 1);
+    }
+    static void loSQI(VU &v, const FP &p, uint8_t *, uint32_t size)
+    {
+        uint32_t addr = (static_cast<uint32_t>(static_cast<uint16_t>(v.m_state.vi[p.vit]))) * 16u;
+        addr &= (size - 1u);
+        if (addr + 16u <= size)
+        {
+            uint32_t words[4];
+            std::memcpy(words, v.m_state.vf[p.lfs], 16);
+            v.queueStore(addr, words, p.ldest);
+        }
+        if (p.vit != 0u)
+            v.m_state.vi[p.vit] = static_cast<int16_t>(v.m_state.vi[p.vit] + 1);
+    }
+    static void loIADDIU(VU &v, const FP &p, uint8_t *, uint32_t)
+    {
+        if (p.vit != 0u)
+            v.m_state.vi[p.vit] = static_cast<int16_t>(v.m_state.vi[p.vis] + p.imm);
+    }
+    static void loISUBIU(VU &v, const FP &p, uint8_t *, uint32_t)
+    {
+        if (p.vit != 0u)
+            v.m_state.vi[p.vit] = static_cast<int16_t>(v.m_state.vi[p.vis] - p.imm);
+    }
+    static void loIADD(VU &v, const FP &p, uint8_t *, uint32_t)
+    {
+        if (p.vid != 0u)
+            v.m_state.vi[p.vid] = static_cast<int16_t>(v.m_state.vi[p.vis] + v.m_state.vi[p.vit]);
+    }
+    static void loISUB(VU &v, const FP &p, uint8_t *, uint32_t)
+    {
+        if (p.vid != 0u)
+            v.m_state.vi[p.vid] = static_cast<int16_t>(v.m_state.vi[p.vis] - v.m_state.vi[p.vit]);
+    }
+    static void loIADDI(VU &v, const FP &p, uint8_t *, uint32_t)
+    {
+        if (p.vit != 0u)
+            v.m_state.vi[p.vit] = static_cast<int16_t>(v.m_state.vi[p.vis] + p.imm);
+    }
+    static void loIAND(VU &v, const FP &p, uint8_t *, uint32_t)
+    {
+        if (p.vid != 0u)
+            v.m_state.vi[p.vid] = v.m_state.vi[p.vis] & v.m_state.vi[p.vit];
+    }
+    static void loIOR(VU &v, const FP &p, uint8_t *, uint32_t)
+    {
+        if (p.vid != 0u)
+            v.m_state.vi[p.vid] = v.m_state.vi[p.vis] | v.m_state.vi[p.vit];
+    }
+    static void loMOVE(VU &v, const FP &p, uint8_t *, uint32_t)
+    {
+        float tmp[4];
+        std::memcpy(tmp, v.m_state.vf[p.lfs], 16);
+        st4(v.m_state.vf[p.lft], tmp, p.ldest);
+    }
+    static void loMR32(VU &v, const FP &p, uint8_t *, uint32_t)
+    {
+        const float *s = v.m_state.vf[p.lfs];
+        const float tmp[4] = {s[1], s[2], s[3], s[0]};
+        st4(v.m_state.vf[p.lft], tmp, p.ldest);
+    }
+    // generic lower needs gs/memory: called through the loop, not through this pointer
+    static void loGenericMarker(VU &, const FP &, uint8_t *, uint32_t) {}
+
+    static FP translate(const VU1Interpreter::DecodedInstructionPair &d, uint8_t shadowFlag)
+    {
+        FP p;
+        p.upper = d.upper;
+        p.lower = d.lower;
+        const uint32_t U = d.upper;
+        p.dest = DEST(U);
+        p.fd = FD(U);
+        p.fs = FS(U);
+        p.ft = FT(U);
+        p.bc = static_cast<uint8_t>(U & 3u);
+        p.flags = static_cast<uint16_t>((d.iBit ? F_IBIT : 0) | (d.eBit ? F_EBIT : 0) | (d.dBit ? F_DBIT : 0) | (d.tBit ? F_TBIT : 0) |
+                                        (d.lowerUsage.pipeline == VU1Interpreter::PipelineBranch ? F_BRANCH : 0) |
+                                        (shadowFlag ? F_SHADOW : 0) |
+                                        ((d.upperUsage.reserved || d.lowerUsage.reserved) ? F_RESERVED : 0) |
+                                        (d.lowerUsage.delaysNextBranchRead ? F_DELAYBR : 0));
+        {
+            const uint32_t viw = static_cast<uint32_t>(d.lowerUsage.viWrite) & 0xFFFEu;
+            uint8_t r = 0;
+            if (viw)
+            {
+                r = 1;
+                while ((viw & (1u << r)) == 0u)
+                    ++r;
+            }
+            p.viw = r;
+        }
+
+        // ---- upper
+        p.up = upGeneric;
+        const uint32_t op = U & 0x3Fu;
+        auto arith = [&](int fam, int src, bool acc) -> UpFn
+        {
+#define SVS_A(F, S)                                                     \
+    if (fam == F && src == S)                                           \
+        return acc ? static_cast<UpFn>(upArith<F, S, true>) : static_cast<UpFn>(upArith<F, S, false>);
+#define SVS_AF(F) SVS_A(F, VT) SVS_A(F, BCS) SVS_A(F, QS) SVS_A(F, IS)
+            SVS_AF(ADD) SVS_AF(SUB) SVS_AF(MUL) SVS_AF(MADD) SVS_AF(MSUB) SVS_AF(MAX) SVS_AF(MINI)
+#undef SVS_AF
+#undef SVS_A
+            return nullptr;
+        };
+        UpFn f = nullptr;
+        if (op < 0x3Cu)
+        {
+            if (op <= 0x1Bu)
+            {
+                static const int famOf[7] = {ADD, SUB, MADD, MSUB, MAX, MINI, MUL};
+                f = arith(famOf[op >> 2], BCS, false);
+            }
+            else
+                switch (op)
+                {
+                case 0x1C: f = arith(MUL, QS, false); break;
+                case 0x1D: f = arith(MAX, IS, false); break;
+                case 0x1E: f = arith(MUL, IS, false); break;
+                case 0x1F: f = arith(MINI, IS, false); break;
+                case 0x20: f = arith(ADD, QS, false); break;
+                case 0x21: f = arith(MADD, QS, false); break;
+                case 0x22: f = arith(ADD, IS, false); break;
+                case 0x23: f = arith(MADD, IS, false); break;
+                case 0x24: f = arith(SUB, QS, false); break;
+                case 0x25: f = arith(MSUB, QS, false); break;
+                case 0x26: f = arith(SUB, IS, false); break;
+                case 0x27: f = arith(MSUB, IS, false); break;
+                case 0x28: f = arith(ADD, VT, false); break;
+                case 0x29: f = arith(MADD, VT, false); break;
+                case 0x2A: f = arith(MUL, VT, false); break;
+                case 0x2B: f = arith(MAX, VT, false); break;
+                case 0x2C: f = arith(SUB, VT, false); break;
+                case 0x2D: f = arith(MSUB, VT, false); break;
+                case 0x2E: f = upOuter<false>; break;
+                case 0x2F: f = arith(MINI, VT, false); break;
+                default: break;
+                }
+        }
+        else
+        {
+            const uint8_t sp = static_cast<uint8_t>((U & 0x3u) | ((U >> 4) & 0x7Cu));
+            if (sp <= 0x0Fu)
+            {
+                static const int famA[4] = {ADD, SUB, MADD, MSUB};
+                f = arith(famA[sp >> 2], BCS, true);
+            }
+            else
+                switch (sp)
+                {
+                case 0x10: f = upItof<0>; break;
+                case 0x11: f = upItof<1>; break;
+                case 0x12: f = upItof<2>; break;
+                case 0x13: f = upItof<3>; break;
+                case 0x14: f = upFtoi<0>; break;
+                case 0x15: f = upFtoi<1>; break;
+                case 0x16: f = upFtoi<2>; break;
+                case 0x17: f = upFtoi<3>; break;
+                case 0x18: case 0x19: case 0x1A: case 0x1B: f = arith(MUL, BCS, true); break;
+                case 0x1C: f = arith(MUL, QS, true); break;
+                case 0x1D: f = upAbs; break;
+                case 0x1E: f = arith(MUL, IS, true); break;
+                case 0x20: f = arith(ADD, QS, true); break;
+                case 0x21: f = arith(MADD, QS, true); break;
+                case 0x22: f = arith(ADD, IS, true); break;
+                case 0x23: f = arith(MADD, IS, true); break;
+                case 0x24: f = arith(SUB, QS, true); break;
+                case 0x25: f = arith(MSUB, QS, true); break;
+                case 0x26: f = arith(SUB, IS, true); break;
+                case 0x27: f = arith(MSUB, IS, true); break;
+                case 0x28: f = arith(ADD, VT, true); break;
+                case 0x29: f = arith(MADD, VT, true); break;
+                case 0x2A: f = arith(MUL, VT, true); break;
+                case 0x2C: f = arith(SUB, VT, true); break;
+                case 0x2D: f = arith(MSUB, VT, true); break;
+                case 0x2E: f = upOuter<true>; break;
+                case 0x2F: case 0x30: f = upNop; break;
+                default: break; // CLIP and reserved: interpreter
+                }
+        }
+        if (f)
+        {
+            p.up = f;
+            p.flags |= F_UPFAST;
+        }
+
+        // ---- lower
+        p.lo = loGenericMarker;
+        p.flags |= F_LOGENERIC;
+        if (d.iBit)
+        {
+            p.flags = static_cast<uint16_t>(p.flags & ~F_LOGENERIC);
+            p.flags |= F_NOLOWER;
+            return p;
+        }
+        const uint32_t L = d.lower;
+        p.ldest = static_cast<uint8_t>((L >> 21) & 0xFu);
+        p.lft = FT(L);
+        p.lfs = FS(L);
+        p.vit = VIT(L);
+        p.vis = VIS(L);
+        p.vid = VID(L);
+        LoFn g = nullptr;
+        if (L == 0u || L == 0x8000033Cu)
+            g = loNop;
+        else
+        {
+            const uint8_t opHi = (L >> 25) & 0x7Fu;
+            switch (opHi)
+            {
+            case 0x00: g = loLQ; p.imm = IMM11(L); break;
+            case 0x01: g = loSQ; p.imm = IMM11(L); break;
+            case 0x08: g = loIADDIU; p.imm = static_cast<int16_t>(static_cast<int16_t>(L & 0x7FF) | ((L >> 10) & 0x7800)); break;
+            case 0x09: g = loISUBIU; p.imm = static_cast<int16_t>(static_cast<int16_t>(L & 0x7FF) | ((L >> 10) & 0x7800)); break;
+            case 0x40:
+            {
+                const uint8_t funct = L & 0x3Fu;
+                switch (funct)
+                {
+                case 0x30: g = loIADD; break;
+                case 0x31: g = loISUB; break;
+                case 0x32: g = loIADDI; p.imm = static_cast<int16_t>(static_cast<int32_t>(((L >> 6) & 0x1F) << 27) >> 27); break;
+                case 0x34: g = loIAND; break;
+                case 0x35: g = loIOR; break;
+                case 0x3C: case 0x3D: case 0x3E: case 0x3F:
+                {
+                    const uint8_t f2 = static_cast<uint8_t>((L & 0x3u) | ((L >> 4) & 0x7Cu));
+                    if (f2 == 0x30) g = loMOVE;
+                    else if (f2 == 0x31) g = loMR32;
+                    else if (f2 == 0x34) g = loLQI;
+                    else if (f2 == 0x35) g = loSQI;
+                    break;
+                }
+                default: break;
+                }
+                break;
+            }
+            default: break;
+            }
+        }
+        if (g)
+        {
+            p.lo = g;
+            p.flags = static_cast<uint16_t>(p.flags & ~F_LOGENERIC);
+        }
+        return p;
+    }
+}
+
+// Pre-translate the decoded code cache (VU1 only).
+static void svsFastTranslate(VU1Interpreter &v, uint32_t pairCount)
+{
+    for (uint32_t i = 0; i < pairCount; ++i)
+    {
+        const auto &d = v.m_decodedCodeCache[i];
+        svsfast::s_fp[i] = svsfast::translate(d, d.upperVfShadowReg);
+    }
+    svsfast::s_fpValid = true;
+}
+
+static bool svsCheckEnabled()
+{
+    static const bool on = std::getenv("SVS_VU_CHECK") != nullptr;
+    return on;
+}
+
+// Compare fast vs interpreter on one op (debug, SVS_VU_CHECK=1).
+template <typename FastCall, typename RefCall>
+static void svsCheckOp(VU1Interpreter &v, uint8_t *vuData, uint32_t dataSize, const char *what, uint32_t instr, FastCall fast, RefCall ref)
+{
+    static std::vector<uint8_t> memBefore, memFast;
+    const VU1State before = v.m_state;
+    if (vuData)
+        memBefore.assign(vuData, vuData + dataSize);
+    fast();
+    const VU1State afterFast = v.m_state;
+    if (vuData)
+        memFast.assign(vuData, vuData + dataSize);
+    v.m_state = before;
+    if (vuData)
+        std::memcpy(vuData, memBefore.data(), dataSize);
+    ref();
+    bool same = std::memcmp(v.m_state.vf, afterFast.vf, sizeof(afterFast.vf)) == 0 &&
+                std::memcmp(v.m_state.vi, afterFast.vi, sizeof(afterFast.vi)) == 0 &&
+                std::memcmp(v.m_state.acc, afterFast.acc, sizeof(afterFast.acc)) == 0;
+    if (vuData && same)
+        same = std::memcmp(vuData, memFast.data(), dataSize) == 0;
+    static int reports = 0;
+    if (!same && reports < 40)
+    {
+        ++reports;
+        std::fprintf(stderr, "[vu-check] DIFERENCIA %s instr=%08x pc=0x%x\n", what, instr, v.m_state.pc);
+    }
+}
+
+// Returns 1 = program ended, 2 = stopped (budget / stop request), 0 = hand the rest to
+// the interpreter loop (state is consistent at a pair boundary).
+static int svsFastLoop(VU1Interpreter &v, uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData, uint32_t dataSize, GS &gs,
+                       PS2Memory *memory, uint64_t budgetEnd, const SvsPairTiming *timing, const bool *pairFlags)
+{
+    using namespace svsfast;
+    const bool check = svsCheckEnabled();
+    const uint32_t mask = v.microAddressMask();
+    uint64_t *vfr = &v.m_vfReady[0][0];
+    while (v.m_cycle < budgetEnd && !v.m_stopRequested)
+    {
+        v.commitReadyPipelines();
+        const uint32_t pc = v.m_state.pc;
+        if ((pc & 7u) != 0u || pc + 8u > codeSize)
+            return 0;
+        const uint32_t idx = pc >> 3;
+        const FP &p = s_fp[idx];
+        if (p.flags & F_RESERVED)
+            return 0;
+        const SvsPairTiming &t = timing[idx];
+
+        auto ready = [&]() -> uint64_t
+        {
+            uint64_t r = v.m_cycle;
+            for (uint32_t k = 0; k < t.nVf; ++k)
+                r = std::max(r, vfr[t.vf[k]]);
+            for (uint32_t k = 0; k < t.nVi; ++k)
+                r = std::max(r, v.m_viReady[t.vi[k]]);
+            for (uint32_t k = 0; k < t.nAcc; ++k)
+                r = std::max(r, v.m_accReady[t.acc[k]]);
+            if (t.special)
+                r = std::max(r, v.calculatePairReadyCycle(v.m_decodedCodeCache[idx]));
+            return r;
+        };
+        uint64_t readyCycle = ready();
+        ++g_svsVuInstr;
+        if (readyCycle > v.m_cycle)
+        {
+            g_svsVuStallCycles += readyCycle - v.m_cycle;
+            while (readyCycle > v.m_cycle)
+            {
+                if (readyCycle >= budgetEnd)
+                {
+                    v.advanceTo(budgetEnd);
+                    break;
+                }
+                v.advanceTo(readyCycle);
+                readyCycle = ready();
+            }
+            if (v.m_cycle >= budgetEnd)
+                return 2;
+        }
+
+        const bool flagsLive = pairFlags[idx];
+        s_svsFlagsLive[1] = flagsLive;
+        const int32_t oldVi = p.viw ? v.m_state.vi[p.viw] : 0;
+
+        if (p.flags & F_SHADOW)
+        {
+            const auto &d = v.m_decodedCodeCache[idx];
+            float oldVf[4], upperVf[4];
+            std::memcpy(oldVf, v.m_state.vf[d.upperVfShadowReg], 16);
+            v.execUpper(d.upper);
+            std::memcpy(upperVf, v.m_state.vf[d.upperVfShadowReg], 16);
+            std::memcpy(v.m_state.vf[d.upperVfShadowReg], oldVf, 16);
+            v.execLower(d.lower, vuData, dataSize, gs, memory, d.upper);
+            std::memcpy(v.m_state.vf[d.upperVfShadowReg], upperVf, 16);
+        }
+        else
+        {
+            // upper
+            if ((p.flags & F_UPFAST) && !flagsLive)
+            {
+                if (check)
+                    svsCheckOp(v, nullptr, 0, "upper", p.upper, [&] { p.up(v, p); }, [&] { v.execUpper(p.upper); });
+                else
+                    p.up(v, p);
+            }
+            else
+                v.execUpper(p.upper);
+            // lower
+            if (p.flags & F_NOLOWER)
+            {
+                float imm;
+                std::memcpy(&imm, &p.lower, 4);
+                v.m_state.i = v.normalizeOperand(imm);
+            }
+            else if (p.flags & F_LOGENERIC)
+                v.execLower(p.lower, vuData, dataSize, gs, memory, p.upper);
+            else if (check)
+                svsCheckOp(v, vuData, dataSize, "lower", p.lower, [&] { p.lo(v, p, vuData, dataSize); },
+                           [&] { v.execLower(p.lower, vuData, dataSize, gs, memory, p.upper); });
+            else
+                p.lo(v, p, vuData, dataSize);
+        }
+
+        v.m_viBranchBackupValid = false;
+        for (uint32_t k = 0; k < t.nW; ++k)
+        {
+            const uint8_t w = t.w[k];
+            const uint64_t when = v.m_cycle + t.wLat[k];
+            if (w < 128u)
+                vfr[w] = when;
+            else if (w < 144u)
+                v.m_viReady[w - 128u] = when;
+            else
+                v.m_accReady[w - 144u] = when;
+        }
+        if (p.viw != 0u && (p.flags & F_DELAYBR))
+            v.recordViWriteForBranch(p.viw, oldVi);
+
+        v.m_state.vf[0][0] = 0.0f;
+        v.m_state.vf[0][1] = 0.0f;
+        v.m_state.vf[0][2] = 0.0f;
+        v.m_state.vf[0][3] = 1.0f;
+        v.m_state.vi[0] = 0;
+
+        uint32_t nextPc = pc + 8u;
+        if (nextPc >= codeSize)
+            nextPc = 0u;
+        v.m_state.pc = nextPc;
+        if (v.m_state.branchPending)
+        {
+            if (v.m_state.branchDelay == 0u)
+            {
+                v.m_state.pc = v.m_state.branchTarget & mask;
+                v.m_state.branchPending = false;
+                if (svsAotDumpDir())
+                {
+                    // record dynamic jump targets (JR/JALR) as AOT entry points
+                    static std::set<std::pair<uint64_t, uint32_t>> seenJ;
+                    if (seenJ.insert({s_svsCodeHash[1], v.m_state.pc}).second)
+                    {
+                        char path[1024];
+                        std::snprintf(path, sizeof(path), "%s/vu1_%016llx.entries", svsAotDumpDir(), (unsigned long long)s_svsCodeHash[1]);
+                        if (std::FILE *f = std::fopen(path, "ab"))
+                        {
+                            std::fprintf(f, "%u\n", v.m_state.pc);
+                            std::fclose(f);
+                        }
+                    }
+                }
+            }
+            else
+                --v.m_state.branchDelay;
+        }
+
+        bool programEnded = false;
+        const bool dHalt = (p.flags & F_DBIT) && v.m_state.dBitEnabled;
+        const bool tHalt = (p.flags & F_TBIT) && v.m_state.tBitEnabled;
+        const bool haltBit = dHalt || tHalt;
+        const bool haltBranch = haltBit && (p.flags & F_BRANCH);
+        if (v.m_state.haltAfterDelaySlot)
+        {
+            v.m_state.stoppedByD = v.m_pendingHaltD;
+            v.m_state.stoppedByT = v.m_pendingHaltT;
+            programEnded = true;
+        }
+        else if (v.m_state.ebit)
+            programEnded = true;
+        else if (haltBit && !haltBranch)
+        {
+            v.m_state.stoppedByD = dHalt;
+            v.m_state.stoppedByT = tHalt;
+            programEnded = true;
+        }
+        else if (p.flags & F_EBIT)
+            v.m_state.ebit = true;
+        else if (haltBranch)
+        {
+            v.m_state.haltAfterDelaySlot = true;
+            v.m_pendingHaltD = dHalt;
+            v.m_pendingHaltT = tHalt;
+        }
+        v.advanceOneCycle();
+        if (programEnded)
+            return 1;
+    }
+    return 2;
+}
+
+// Stall helper for the AOT-compiled programs (same loop as the interpreter).
+static bool svsAotStall(VU1Interpreter &v, uint32_t idx, uint64_t readyCycle, uint64_t budgetEnd)
+{
+    const SvsPairTiming &t = s_svsTiming[1][idx];
+    uint64_t *vfr = &v.m_vfReady[0][0];
+    g_svsVuStallCycles += readyCycle - v.m_cycle;
+    while (readyCycle > v.m_cycle)
+    {
+        if (readyCycle >= budgetEnd)
+        {
+            v.advanceTo(budgetEnd);
+            break;
+        }
+        v.advanceTo(readyCycle);
+        uint64_t r = v.m_cycle;
+        for (uint32_t k = 0; k < t.nVf; ++k)
+            r = std::max(r, vfr[t.vf[k]]);
+        for (uint32_t k = 0; k < t.nVi; ++k)
+            r = std::max(r, v.m_viReady[t.vi[k]]);
+        for (uint32_t k = 0; k < t.nAcc; ++k)
+            r = std::max(r, v.m_accReady[t.acc[k]]);
+        if (t.special)
+            r = std::max(r, v.calculatePairReadyCycle(v.m_decodedCodeCache[idx]));
+        readyCycle = r;
+    }
+    return v.m_cycle >= budgetEnd;
+}
