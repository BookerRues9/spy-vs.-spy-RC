+// ---- GS path thread (see ps2_memory.h) -----------------------------------------
+std::atomic<uint64_t> g_svsGsWaitNs{0}; // game thread time spent waiting for the GS thread
+namespace
+{
+    struct SvsGsWorker
+    {
+        std::mutex m;
+        std::condition_variable cv, doneCv;
+        std::deque<std::function<void()>> q;
+        std::atomic<uint64_t> posted{0}, done{0};
+        std::once_flag started;
+    };
+    SvsGsWorker &svsGsW()
+    {
+        static SvsGsWorker *w = new SvsGsWorker(); // never destroyed: lives until exit
+        return *w;
+    }
+    thread_local bool t_svsOnGsWorker = false;
+    std::atomic<bool> g_svsWindowIdSet{false};
+    std::thread::id g_svsWindowId;
+
+    bool svsIsWindowThread()
+    {
+        return g_svsWindowIdSet.load(std::memory_order_acquire) && std::this_thread::get_id() == g_svsWindowId;
+    }
+
+    void svsGsWorkerLoop()
+    {
+        t_svsOnGsWorker = true;
+        SvsGsWorker &w = svsGsW();
+        for (;;)
+        {
+            std::function<void()> fn;
+            {
+                std::unique_lock<std::mutex> lock(w.m);
+                w.cv.wait(lock, [&]() { return !w.q.empty(); });
+                fn = std::move(w.q.front());
+                w.q.pop_front();
+            }
+            try
+            {
+                fn();
+            }
+            catch (const std::exception &e)
+            {
+                std::fprintf(stderr, "[svs-gs] error en el hilo GS: %s\n", e.what());
+            }
+            catch (...)
+            {
+                std::fprintf(stderr, "[svs-gs] error en el hilo GS\n");
+            }
+            {
+                std::lock_guard<std::mutex> lock(w.m);
+                w.done.fetch_add(1u, std::memory_order_acq_rel);
+            }
+            w.doneCv.notify_all();
+        }
+    }
+
+    struct SvsWaitTimer
+    {
+        std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+        ~SvsWaitTimer()
+        {
+            g_svsGsWaitNs.fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count()));
+        }
+    };
+    void svsGsWaitDone(uint64_t target)
+    {
+        SvsGsWorker &w = svsGsW();
+        if (w.done.load(std::memory_order_acquire) >= target)
+            return;
+        SvsWaitTimer timer;
+        if (svsIsWindowThread())
+        {
+            // the window thread may be the GPU renderer the worker is waiting for
+            while (w.done.load(std::memory_order_acquire) < target)
+            {
+#if defined(PS2X_GL_BACKEND)
+                if (!svsGlPumpWhileBlocked())
+#endif
+                    std::this_thread::yield();
+            }
+            return;
+        }
+        std::unique_lock<std::mutex> lock(w.m);
+        w.doneCv.wait(lock, [&]() { return w.done.load(std::memory_order_acquire) >= target; });
+    }
+}
+
+bool svsGsThreadEnabled()
+{
+    static const bool on = []() {
+        const char *v = std::getenv("SVS_GS_THREAD");
+        const bool enabled = !(v && v[0] == '0');
+        std::fprintf(stderr, "[svs-gs] hilo GS/VU1 %s\n", enabled ? "activo" : "apagado (SVS_GS_THREAD=0)");
+        return enabled;
+    }();
+    return on;
+}
+
+bool svsGsOnWorker() { return t_svsOnGsWorker; }
+
+void svsGsSetWindowThread()
+{
+    g_svsWindowId = std::this_thread::get_id();
+    g_svsWindowIdSet.store(true, std::memory_order_release);
+}
+
+bool svsGsShouldForward()
+{
+    return !t_svsOnGsWorker && svsGsThreadEnabled() && !svsIsWindowThread();
+}
+
+void svsGsPost(std::function<void()> fn)
+{
+    SvsGsWorker &w = svsGsW();
+    std::call_once(w.started, []() { std::thread(svsGsWorkerLoop).detach(); });
+    {
+        std::lock_guard<std::mutex> lock(w.m);
+        w.q.push_back(std::move(fn));
+        w.posted.fetch_add(1u, std::memory_order_acq_rel);
+    }
+    w.cv.notify_one();
+}
+
+void svsGsSync()
+{
+    if (t_svsOnGsWorker || !svsGsThreadEnabled())
+        return;
+    SvsGsWorker &w = svsGsW();
+    const uint64_t target = w.posted.load(std::memory_order_acquire);
+    if (w.done.load(std::memory_order_acquire) >= target)
+        return;
+    svsGsWaitDone(target);
+}
+
+// Every VBlank (game thread): the game may run at most SVS_GS_LAG (2) vblanks ahead of
+// the GS thread, so the queue never grows and the picture does not lag behind input.
+void svsGsVblankThrottle()
+{
+    if (t_svsOnGsWorker || !svsGsThreadEnabled() || svsIsWindowThread())
+        return;
+    static const uint32_t lag = std::max(1, std::getenv("SVS_GS_LAG") ? std::atoi(std::getenv("SVS_GS_LAG")) : 2);
+    static uint64_t seqs[8] = {};
+    static uint32_t idx = 0;
+    SvsGsWorker &w = svsGsW();
+    const uint64_t prev = seqs[(idx + 8u - (std::min<uint32_t>(lag, 7u) - 1u)) % 8u];
+    idx = (idx + 1u) % 8u;
+    seqs[idx] = w.posted.load(std::memory_order_acquire);
+    if (w.done.load(std::memory_order_acquire) < prev)
+        svsGsWaitDone(prev);
+}
+
+void svsGsCall(const std::function<void()> &fn)
+{
+    if (!svsGsShouldForward())
+    {
+        fn();
+        return;
+    }
+    SvsGsWorker &w = svsGsW();
+    std::call_once(w.started, []() { std::thread(svsGsWorkerLoop).detach(); });
+    uint64_t id = 0;
+    {
+        std::lock_guard<std::mutex> lock(w.m);
+        w.q.push_back([&fn]() { fn(); });
+        id = w.posted.fetch_add(1u, std::memory_order_acq_rel) + 1u;
+    }
+    w.cv.notify_one();
+    svsGsWaitDone(id);
+}
