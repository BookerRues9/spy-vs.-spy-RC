+void GSCpuBackend::ReadRectRaw(uint32_t psm, uint32_t baseBlock, uint32_t bw, uint32_t x0, uint32_t y0, uint32_t w, uint32_t h, uint32_t *out) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram)
+        return;
+    static const bool slow = std::getenv("SVS_GS_SLOW_RECT") != nullptr;
+    if (const SvsPage32 *pg = (!slow && (baseBlock & 31u) == 0u && bw != 0u) ? svsPage32(psm) : nullptr)
+    {
+        const uint32_t mask = (psm & 1u) ? 0x00FFFFFFu : 0xFFFFFFFFu;
+        for (uint32_t y = 0; y < h; ++y)
+        {
+            const uint32_t yy = y0 + y;
+            const uint32_t rowPage = (baseBlock >> 5) + (yy >> 5) * bw;
+            const uint16_t *offs = pg->off[yy & 31u];
+            uint32_t *dst = out + static_cast<size_t>(y) * w;
+            for (uint32_t x = 0; x < w; ++x)
+            {
+                const uint32_t xx = x0 + x;
+                const uint32_t addr = (((rowPage + (xx >> 6)) * 8192u) + offs[xx & 63u]) & 0x3FFFFFu;
+                uint32_t v;
+                std::memcpy(&v, m_vram + addr, 4);
+                dst[x] = v & mask;
+            }
+        }
+        return;
+    }
+    const ReadVramFunc fn = m_readVramFuncs[psm & 0x3Fu];
+    for (uint32_t y = 0; y < h; ++y)
+        for (uint32_t x = 0; x < w; ++x)
+            out[static_cast<size_t>(y) * w + x] = fn(m_vram, baseBlock, bw, x0 + x, y0 + y);
+}
+
+void GSCpuBackend::WriteRectRaw(uint32_t psm, uint32_t baseBlock, uint32_t bw, uint32_t x0, uint32_t y0, uint32_t w, uint32_t h, const uint32_t *in)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram)
+        return;
+    static const bool slow = std::getenv("SVS_GS_SLOW_RECT") != nullptr;
+    if (const SvsPage32 *pg = (!slow && (baseBlock & 31u) == 0u && bw != 0u) ? svsPage32(psm) : nullptr)
+    {
+        const bool keepTop = (psm & 1u) != 0u; // 24-bit formats keep the top byte
+        for (uint32_t y = 0; y < h; ++y)
+        {
+            const uint32_t yy = y0 + y;
+            const uint32_t rowPage = (baseBlock >> 5) + (yy >> 5) * bw;
+            const uint16_t *offs = pg->off[yy & 31u];
+            const uint32_t *src = in + static_cast<size_t>(y) * w;
+            for (uint32_t x = 0; x < w; ++x)
+            {
+                const uint32_t xx = x0 + x;
+                const uint32_t addr = (((rowPage + (xx >> 6)) * 8192u) + offs[xx & 63u]) & 0x3FFFFFu;
+                uint32_t v = src[x];
+                if (keepTop)
+                {
+                    uint32_t old;
+                    std::memcpy(&old, m_vram + addr, 4);
+                    v = (v & 0x00FFFFFFu) | (old & 0xFF000000u);
+                }
+                std::memcpy(m_vram + addr, &v, 4);
+            }
+        }
+        m_texturePageCache.Invalidate();
+        return;
+    }
+    const WriteVramFunc fn = m_writeVramFuncs[psm & 0x3Fu];
+    for (uint32_t y = 0; y < h; ++y)
+        for (uint32_t x = 0; x < w; ++x)
+            fn(m_vram, baseBlock, bw, x0 + x, y0 + y, in[static_cast<size_t>(y) * w + x]);
+    m_texturePageCache.Invalidate();
+}
