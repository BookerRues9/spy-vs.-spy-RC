+// ---- SPU2 ----
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kSpuBase = 0x1F900000u;
+        constexpr uint32_t kRamWords = 1u << 20; // 2 MB
+        constexpr uint32_t kRingFrames = 8192u;
+        constexpr uint32_t kRingKeep = 3072u; // ~64 ms of latency at most
+        constexpr int32_t kAdpcmF0[5] = {0, 60, 115, 98, 122};
+        constexpr int32_t kAdpcmF1[5] = {0, 0, -52, -55, -60};
+
+        int32_t decodeVolume(uint16_t v)
+        {
+            return static_cast<int16_t>(static_cast<uint16_t>(v << 1)) / 2; // -0x4000..0x3FFF
+        }
+        // Volume register write: fixed volumes take effect; sweep mode (bit 15) is not
+        // emulated and keeps the previous level (sweeps start from it).
+        void setGain(int32_t &gain, uint16_t v)
+        {
+            if ((v & 0x8000u) == 0u)
+                gain = decodeVolume(v);
+        }
+
+        int32_t clamp16(int32_t v)
+        {
+            return v < -32768 ? -32768 : (v > 32767 ? 32767 : v);
+        }
+
+        bool traceEnabled()
+        {
+            static const bool t = std::getenv("SVS_SPU2_TRACE") != nullptr;
+            return t;
+        }
+    }
+
+    Spu2 &Spu2::instance()
+    {
+        static Spu2 s;
+        return s;
+    }
+
+    Spu2::Spu2() : m_ram(kRamWords, 0u), m_ring(kRingFrames * 2u, 0)
+    {
+    }
+
+    Spu2::~Spu2()
+    {
+        m_quit = true;
+        if (m_thread.joinable())
+            m_thread.join();
+    }
+
+    void Spu2::start()
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_started || std::getenv("SVS_NO_SPU2"))
+            return;
+        m_started = true;
+        m_thread = std::thread([this]() { producerLoop(); });
+    }
+
+    void Spu2::reset()
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        std::fill(m_ram.begin(), m_ram.end(), 0u);
+        std::memset(m_regs, 0, sizeof(m_regs));
+        for (Core &c : m_cores)
+            c = Core{};
+    }
+
+    void Spu2::checkIrq(Core &core, int c, uint32_t wordAddr)
+    {
+        if ((core.attr & 0x40u) == 0u)
+            return;
+        if ((core.irqa & ~7u) == (wordAddr & ~7u))
+        {
+            raw(0x7C2) |= static_cast<uint16_t>(4u << c);
+            m_irqPending = true;
+        }
+    }
+
+    void Spu2::keyOn(Core &core, int c, uint32_t mask)
+    {
+        for (int i = 0; i < 24; ++i)
+        {
+            if ((mask & (1u << i)) == 0u)
+                continue;
+            Voice &v = core.voices[i];
+            v.on = true;
+            v.phase = 1;
+            v.env = 0;
+            v.envCounter = 0;
+            v.nax = v.ssa;
+            v.blockAddr = v.ssa;
+            v.sampleIndex = 28;
+            v.pos = 0;
+            v.s1 = v.s2 = 0;
+            v.prev = v.cur = 0;
+            v.lsaxSet = false;
+            core.endx &= ~(1u << i);
+            if (traceEnabled())
+                std::fprintf(stderr, "[spu2] KON core%d v%d ssa=%05x pitch=%04x adsr=%04x/%04x vol=%04x/%04x vmix=%06x/%06x wet=%04x%04x/%04x%04x mmix=%04x mvol=%04x/%04x evol=%04x attr=%04x\n", c, i, v.ssa, v.pitch,
+                             v.adsr1, v.adsr2, v.volL, v.volR, core.vmixl, core.vmixr, raw(c * 0x400 + 0x18E), raw(c * 0x400 + 0x18C), raw(c * 0x400 + 0x196), raw(c * 0x400 + 0x194),
+                             raw(c * 0x400 + 0x198), core.mvolL, core.mvolR, raw(0x764 + c * 0x28), core.attr);
+        }
+    }
+
+    void Spu2::keyOff(Core &core, uint32_t mask)
+    {
+        for (int i = 0; i < 24; ++i)
+            if ((mask & (1u << i)) != 0u && core.voices[i].on)
+            {
+                core.voices[i].phase = 4;
+                core.voices[i].envCounter = 0;
+            }
+    }
+
+    void Spu2::decodeBlock(Core &core, int c, Voice &v)
+    {
+        const uint32_t addr = v.nax & (kRamWords - 1u) & ~7u;
+        v.blockAddr = addr;
+        checkIrq(core, c, addr);
+        const uint16_t w0 = m_ram[addr];
+        const int shift = std::min(w0 & 0xF, 12) == (w0 & 0xF) ? (w0 & 0xF) : 9;
+        const int filter = std::min((w0 >> 4) & 7, 4);
+        v.blockFlags = static_cast<uint8_t>(w0 >> 8);
+        if (traceEnabled() && c == 1 && (v.gainL != 0 || v.volL != 0))
+        {
+            static int n = 0;
+            if (n++ < 40)
+                std::fprintf(stderr, "[spu2] blk core1 v%d addr=%05x w0=%04x w1=%04x env=%d phase=%d gain=%d/%d\n", static_cast<int>(&v - core.voices), addr, w0, m_ram[(addr + 1u) & (kRamWords - 1u)], v.env, v.phase, v.gainL, v.gainR);
+        }
+        if ((v.blockFlags & 4u) != 0u && !v.lsaxSet)
+            v.lsax = addr;
+        for (int i = 0; i < 28; ++i)
+        {
+            const uint16_t word = m_ram[(addr + 1u + static_cast<uint32_t>(i / 4)) & (kRamWords - 1u)];
+            int32_t nibble = (word >> ((i & 3) * 4)) & 0xF;
+            int32_t s = static_cast<int16_t>(static_cast<uint16_t>(nibble << 12)) >> shift;
+            s += (v.s1 * kAdpcmF0[filter] + v.s2 * kAdpcmF1[filter] + 32) >> 6;
+            s = clamp16(s);
+            v.s2 = v.s1;
+            v.s1 = s;
+            v.buf[i] = static_cast<int16_t>(s);
+        }
+        v.sampleIndex = 0;
+    }
+
+    int16_t Spu2::nextSample(Core &core, int c, Voice &v)
+    {
+        if (v.sampleIndex >= 28)
+            decodeBlock(core, c, v);
+        const int16_t s = v.buf[v.sampleIndex++];
+        if (v.sampleIndex >= 28)
+        {
+            // end of block: follow the loop flags
+            const uint32_t bit = 1u << static_cast<uint32_t>(&v - core.voices);
+            if ((v.blockFlags & 1u) != 0u)
+            {
+                core.endx |= bit;
+                v.nax = v.lsax;
+                if ((v.blockFlags & 2u) == 0u)
+                {
+                    // one-shot end: the voice is muted
+                    v.phase = 0;
+                    v.env = 0;
+                    v.on = false;
+                }
+            }
+            else
+            {
+                v.nax = (v.blockAddr + 8u) & (kRamWords - 1u);
+            }
+        }
+        return s;
+    }
+
+    void Spu2::stepEnvelope(Voice &v)
+    {
+        int shift = 0, step = 0;
+        bool exp = false, decrease = false;
+        int32_t target = 0;
+        switch (v.phase)
+        {
+        case 1: // attack
+            exp = (v.adsr1 & 0x8000u) != 0u;
+            shift = (v.adsr1 >> 10) & 0x1F;
+            step = 7 - ((v.adsr1 >> 8) & 3);
+            target = 0x7FFF;
+            break;
+        case 2: // decay
+            exp = true;
+            decrease = true;
+            shift = (v.adsr1 >> 4) & 0xF;
+            step = -8;
+            target = (((v.adsr1 & 0xF) + 1) * 0x800);
+            break;
+        case 3: // sustain
+            exp = (v.adsr2 & 0x8000u) != 0u;
+            decrease = (v.adsr2 & 0x4000u) != 0u;
+            shift = (v.adsr2 >> 8) & 0x1F;
+            step = decrease ? (-8 + ((v.adsr2 >> 6) & 3)) : (7 - ((v.adsr2 >> 6) & 3));
+            break;
+        case 4: // release
+            exp = (v.adsr2 & 0x20u) != 0u;
+            decrease = true;
+            shift = v.adsr2 & 0x1F;
+            step = -8;
+            break;
+        default:
+            return;
+        }
+        int32_t cycles = 1 << std::max(0, shift - 11);
+        int32_t delta = step << std::max(0, 11 - shift);
+        if (exp && !decrease && v.env > 0x6000)
+            cycles *= 4;
+        if (exp && decrease)
+            delta = (delta * v.env) >> 15;
+        if (++v.envCounter < cycles)
+            return;
+        v.envCounter = 0;
+        v.env += delta;
+        if (v.env > 0x7FFF)
+            v.env = 0x7FFF;
+        if (v.env < 0)
+            v.env = 0;
+        if (v.phase == 1 && v.env >= target)
+            v.phase = 2;
+        else if (v.phase == 2 && v.env <= target)
+            v.phase = 3;
+        else if (v.phase == 4 && v.env <= 0)
+        {
+            v.phase = 0;
+            v.on = false;
+        }
+    }
+
+    void Spu2::mixFrames(int16_t *out, uint32_t frames)
+    {
+        for (uint32_t f = 0; f < frames; ++f)
+        {
+            int32_t outL = 0, outR = 0;
+            for (int c = 0; c < 2; ++c)
+            {
+                Core &core = m_cores[c];
+                int32_t coreL = 0, coreR = 0;
+                for (int i = 0; i < 24; ++i)
+                {
+                    Voice &v = core.voices[i];
+                    if (!v.on)
+                        continue;
+                    uint32_t pitch = std::min<uint32_t>(v.pitch, 0x3FFFu);
+                    v.pos += pitch;
+                    while (v.pos >= 0x1000u && v.on)
+                    {
+                        v.pos -= 0x1000u;
+                        v.prev = v.cur;
+                        v.cur = nextSample(core, c, v);
+                    }
+                    if (!v.on)
+                        continue;
+                    const int32_t frac = static_cast<int32_t>(v.pos);
+                    int32_t s = v.prev + (((v.cur - v.prev) * frac) >> 12);
+                    s = (s * v.env) >> 15;
+                    stepEnvelope(v);
+                    if ((core.vmixl & (1u << i)) != 0u)
+                        coreL += (s * v.gainL) >> 14;
+                    if ((core.vmixr & (1u << i)) != 0u)
+                        coreR += (s * v.gainR) >> 14;
+                }
+                static const int onlyCore = std::getenv("SVS_SPU2_ONLYCORE") ? std::atoi(std::getenv("SVS_SPU2_ONLYCORE")) : -1;
+                if (onlyCore >= 0 && onlyCore != c)
+                    continue;
+                outL += (coreL * core.mgainL) >> 14;
+                outR += (coreR * core.mgainR) >> 14;
+            }
+            out[f * 2] = static_cast<int16_t>(clamp16(outL));
+            out[f * 2 + 1] = static_cast<int16_t>(clamp16(outR));
+        }
+    }
+
+    namespace
+    {
+        // Movie (PSS) audio. The game's IOP stream player never starts under the HLE
+        // IOP, so the MPEG HLE hands us the private_stream_1 payload (SShd/SSbd
+        // interleaved PS-ADPCM) and it is decoded here and mixed into the output.
+        struct MovieAudio
+        {
+            std::mutex mutex;
+            bool active = false;
+            uint32_t channels = 2, interleave = 0x200;
+            bool pcm = false; // SShd codec 0x01 = 16-bit PCM LE, 0x10 = PS-ADPCM
+            std::vector<uint8_t> pending;
+            int32_t s1[2] = {0, 0}, s2[2] = {0, 0};
+            std::vector<int16_t> fifo = std::vector<int16_t>(48000u * 8u * 2u);
+            size_t rd = 0, wr = 0, count = 0;
+
+            void reset()
+            {
+                active = false;
+                pending.clear();
+                s1[0] = s1[1] = s2[0] = s2[1] = 0;
+                rd = wr = count = 0;
+            }
+            void pushFrame(int16_t l, int16_t r)
+            {
+                const size_t cap = fifo.size() / 2u;
+                if (count >= cap) { rd = (rd + 1u) % cap; --count; }
+                fifo[wr * 2u] = l; fifo[wr * 2u + 1u] = r;
+                wr = (wr + 1u) % cap; ++count;
+            }
+            void decodeChannel(const uint8_t *src, uint32_t bytes, int ch, std::vector<int16_t> &out)
+            {
+                if (pcm)
+                {
+                    for (uint32_t b = 0; b + 2u <= bytes; b += 2u)
+                        out.push_back(static_cast<int16_t>(src[b] | (src[b + 1u] << 8)));
+                    return;
+                }
+                for (uint32_t b = 0; b + 16u <= bytes; b += 16u)
+                {
+                    const uint8_t *blk = src + b;
+                    const int shift = (blk[0] & 0xF) > 12 ? 9 : (blk[0] & 0xF);
+                    const int filter = std::min((blk[0] >> 4) & 7, 4);
+                    for (int i = 0; i < 28; ++i)
+                    {
+                        const int nib = (blk[2 + i / 2] >> ((i & 1) * 4)) & 0xF;
+                        int32_t v = static_cast<int16_t>(static_cast<uint16_t>(nib << 12)) >> shift;
+                        v += (s1[ch] * kAdpcmF0[filter] + s2[ch] * kAdpcmF1[filter] + 32) >> 6;
+                        v = std::clamp(v, -32768, 32767);
+                        s2[ch] = s1[ch]; s1[ch] = v;
+                        out.push_back(static_cast<int16_t>(v));
+                    }
+                }
+            }
+            void push(const uint8_t *data, uint32_t size)
+            {
+                if (size >= 40u && std::memcmp(data, "SShd", 4) == 0)
+                {
+                    reset();
+                    uint32_t hdr = 0, ch = 0, il = 0, codec = 0;
+                    std::memcpy(&hdr, data + 4, 4);
+                    std::memcpy(&codec, data + 8, 4);
+                    pcm = codec == 1u;
+                    std::memcpy(&ch, data + 16, 4);
+                    std::memcpy(&il, data + 20, 4);
+                    channels = (ch == 1u) ? 1u : 2u;
+                    interleave = (il >= 16u && il <= 0x10000u) ? (il & ~15u) : 0x200u;
+                    const uint32_t bd = 8u + hdr;
+                    if (bd + 8u > size || std::memcmp(data + bd, "SSbd", 4) != 0)
+                        return;
+                    active = true;
+                    data += bd + 8u;
+                    size -= bd + 8u;
+                }
+                if (!active)
+                    return;
+                pending.insert(pending.end(), data, data + size);
+                const uint32_t unit = interleave * channels;
+                size_t off = 0;
+                std::vector<int16_t> l, r;
+                while (pending.size() - off >= unit)
+                {
+                    l.clear(); r.clear();
+                    decodeChannel(pending.data() + off, interleave, 0, l);
+                    if (channels == 2u)
+                        decodeChannel(pending.data() + off + interleave, interleave, 1, r);
+                    for (size_t i = 0; i < l.size(); ++i)
+                        pushFrame(l[i], channels == 2u ? r[i] : l[i]);
+                    off += unit;
+                }
+                pending.erase(pending.begin(), pending.begin() + static_cast<std::ptrdiff_t>(off));
+            }
+            void mix(int16_t *out, uint32_t frames)
+            {
+                const size_t cap = fifo.size() / 2u;
+                for (uint32_t i = 0; i < frames && count != 0u; ++i)
+                {
+                    out[i * 2u] = static_cast<int16_t>(std::clamp<int32_t>(out[i * 2u] + fifo[rd * 2u], -32768, 32767));
+                    out[i * 2u + 1u] = static_cast<int16_t>(std::clamp<int32_t>(out[i * 2u + 1u] + fifo[rd * 2u + 1u], -32768, 32767));
+                    rd = (rd + 1u) % cap; --count;
+                }
+            }
+        };
+        MovieAudio &movieAudio()
+        {
+            static MovieAudio m;
+            return m;
+        }
+    }
+
+    void Spu2::producerLoop()
+    {
+        using clock = std::chrono::steady_clock;
+        const auto t0 = clock::now();
+        uint64_t produced = 0;
+        std::vector<int16_t> chunk(512u * 2u);
+        while (!m_quit)
+        {
+            const double elapsed = std::chrono::duration<double>(clock::now() - t0).count();
+            const uint64_t target = static_cast<uint64_t>(elapsed * 48000.0);
+            if (target > produced + 48000u) // fell far behind (debugger, suspend): resync
+                produced = target - 512u;
+            while (produced < target && !m_quit)
+            {
+                const uint32_t n = static_cast<uint32_t>(std::min<uint64_t>(512u, target - produced));
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    mixFrames(chunk.data(), n);
+                }
+                {
+                    MovieAudio &ma = movieAudio();
+                    std::lock_guard<std::mutex> lock(ma.mutex);
+                    ma.mix(chunk.data(), n);
+                }
+                static std::FILE *wav = std::getenv("SVS_SPU2_RAW") ? std::fopen(std::getenv("SVS_SPU2_RAW"), "wb") : nullptr;
+                if (wav)
+                    std::fwrite(chunk.data(), sizeof(int16_t), n * 2u, wav);
+                {
+                    std::lock_guard<std::mutex> lock(m_ringMutex);
+                    for (uint32_t i = 0; i < n; ++i)
+                    {
+                        if (m_ringCount >= kRingKeep)
+                        {
+                            m_ringRead = (m_ringRead + 1u) % kRingFrames;
+                            --m_ringCount;
+                        }
+                        m_ring[m_ringWrite * 2u] = chunk[i * 2u];
+                        m_ring[m_ringWrite * 2u + 1u] = chunk[i * 2u + 1u];
+                        m_ringWrite = (m_ringWrite + 1u) % kRingFrames;
+                        ++m_ringCount;
+                    }
+                }
+                produced += n;
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(4));
+        }
+    }
+
+    void Spu2::render(int16_t *out, uint32_t frames)
+    {
+        std::lock_guard<std::mutex> lock(m_ringMutex);
+        for (uint32_t i = 0; i < frames; ++i)
+        {
+            if (m_ringCount == 0u)
+            {
+                out[i * 2u] = out[i * 2u + 1u] = 0;
+                continue;
+            }
+            out[i * 2u] = m_ring[m_ringRead * 2u];
+            out[i * 2u + 1u] = m_ring[m_ringRead * 2u + 1u];
+            m_ringRead = (m_ringRead + 1u) % kRingFrames;
+            --m_ringCount;
+        }
+    }
+
+    void Spu2::dmaWrite(int core, const uint8_t *data, uint32_t bytes)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        Core &c = m_cores[core & 1];
+        const uint32_t words = bytes / 2u;
+        const uint32_t start = c.tsa;
+        for (uint32_t i = 0; i < words; ++i)
+        {
+            uint16_t w;
+            std::memcpy(&w, data + i * 2u, 2);
+            m_ram[(c.tsa + i) & (kRamWords - 1u)] = w;
+        }
+        if ((c.attr & 0x40u) != 0u)
+        {
+            const uint32_t end = start + words;
+            if (c.irqa >= start && c.irqa < end)
+            {
+                raw(0x7C2) |= static_cast<uint16_t>(4u << (core & 1));
+                m_irqPending = true;
+            }
+        }
+        c.tsa = (c.tsa + words) & (kRamWords - 1u);
+        c.statx |= 0x80u;
+        if (traceEnabled())
+            std::fprintf(stderr, "[spu2] DMA core%d tsa=%05x words=%u\n", core, start, words);
+    }
+
+    void Spu2::dmaRead(int core, uint8_t *data, uint32_t bytes)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        Core &c = m_cores[core & 1];
+        const uint32_t words = bytes / 2u;
+        for (uint32_t i = 0; i < words; ++i)
+        {
+            const uint16_t w = m_ram[(c.tsa + i) & (kRamWords - 1u)];
+            std::memcpy(data + i * 2u, &w, 2);
+        }
+        c.tsa = (c.tsa + words) & (kRamWords - 1u);
+        c.statx |= 0x80u;
+    }
+
+    uint16_t Spu2::read16(uint32_t address)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const uint32_t o = (address - kSpuBase) & 0x7FEu;
+        if (o >= 0x760u)
+        {
+            if (o == 0x7C2u)
+            {
+                const uint16_t v = raw(o);
+                return v;
+            }
+            return raw(o);
+        }
+        const int ci = o >= 0x400u ? 1 : 0;
+        Core &core = m_cores[ci];
+        const uint32_t l = o & 0x3FEu;
+        if (l < 0x180u)
+        {
+            Voice &v = core.voices[l >> 4];
+            switch ((l & 0xFu) >> 1)
+            {
+            case 5: return static_cast<uint16_t>(v.env);
+            case 6: return static_cast<uint16_t>((v.gainL * v.env) >> 15);
+            case 7: return static_cast<uint16_t>((v.gainR * v.env) >> 15);
+            default: return raw(o);
+            }
+        }
+        if (l >= 0x1C0u && l < 0x1C0u + 24u * 0xCu)
+        {
+            const uint32_t idx = l - 0x1C0u;
+            Voice &v = core.voices[idx / 0xCu];
+            switch ((idx % 0xCu) >> 1)
+            {
+            case 0: return static_cast<uint16_t>((v.ssa >> 16) & 0xF);
+            case 1: return static_cast<uint16_t>(v.ssa);
+            case 2: return static_cast<uint16_t>((v.lsax >> 16) & 0xF);
+            case 3: return static_cast<uint16_t>(v.lsax);
+            case 4:
+            {
+                const uint32_t nax = v.on ? (v.blockAddr + 1u + static_cast<uint32_t>(std::min(v.sampleIndex, 27) / 4)) : v.nax;
+                return static_cast<uint16_t>((nax >> 16) & 0xF);
+            }
+            case 5:
+            {
+                const uint32_t nax = v.on ? (v.blockAddr + 1u + static_cast<uint32_t>(std::min(v.sampleIndex, 27) / 4)) : v.nax;
+                return static_cast<uint16_t>(nax);
+            }
+            }
+        }
+        switch (l)
+        {
+        case 0x19Au: return core.attr;
+        case 0x19Cu: return static_cast<uint16_t>((core.irqa >> 16) & 0xF);
+        case 0x19Eu: return static_cast<uint16_t>(core.irqa);
+        case 0x1A8u: return static_cast<uint16_t>((core.tsa >> 16) & 0xF);
+        case 0x1AAu: return static_cast<uint16_t>(core.tsa);
+        case 0x340u: return static_cast<uint16_t>(core.endx);
+        case 0x342u: return static_cast<uint16_t>(core.endx >> 16);
+        case 0x344u: return core.statx;
+        default: return raw(o);
+        }
+    }
+
+    void Spu2::write16(uint32_t address, uint16_t value)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const uint32_t o = (address - kSpuBase) & 0x7FEu;
+        raw(o) = value;
+        {
+            static const bool t = std::getenv("SVS_SPU2_REGS") != nullptr;
+            if (t && (o & 0x3FFu) >= 0x180u)
+            {
+                static std::unordered_map<uint32_t, uint32_t> seen;
+                if (seen[o]++ < 6)
+                    std::fprintf(stderr, "[spu2-reg] %03x = %04x\n", o, value);
+            }
+        }
+        if (o >= 0x760u)
+        {
+            switch (o)
+            {
+            case 0x760u: m_cores[0].mvolL = value; setGain(m_cores[0].mgainL, value); break;
+            case 0x762u: m_cores[0].mvolR = value; setGain(m_cores[0].mgainR, value); break;
+            case 0x788u: m_cores[1].mvolL = value; setGain(m_cores[1].mgainL, value); break;
+            case 0x78Au: m_cores[1].mvolR = value; setGain(m_cores[1].mgainR, value); break;
+            case 0x7C2u: raw(o) = 0; break; // IRQINFO: write clears
+            default: break;
+            }
+            return;
+        }
+        const int ci = o >= 0x400u ? 1 : 0;
+        Core &core = m_cores[ci];
+        const uint32_t l = o & 0x3FEu;
+        if (l < 0x180u)
+        {
+            Voice &v = core.voices[l >> 4];
+            switch ((l & 0xFu) >> 1)
+            {
+            case 0: v.volL = value; setGain(v.gainL, value); break;
+            case 1: v.volR = value; setGain(v.gainR, value); break;
+            case 2: v.pitch = value; break;
+            case 3: v.adsr1 = value; break;
+            case 4: v.adsr2 = value; break;
+            case 5: v.env = value & 0x7FFF; break;
+            default: break;
+            }
+            return;
+        }
+        if (l >= 0x1C0u && l < 0x1C0u + 24u * 0xCu)
+        {
+            const uint32_t idx = l - 0x1C0u;
+            Voice &v = core.voices[idx / 0xCu];
+            switch ((idx % 0xCu) >> 1)
+            {
+            case 0: v.ssa = (v.ssa & 0xFFFFu) | ((value & 0xFu) << 16); break;
+            case 1: v.ssa = (v.ssa & 0xF0000u) | value; break;
+            case 2: v.lsax = (v.lsax & 0xFFFFu) | ((value & 0xFu) << 16); v.lsaxSet = true; break;
+            case 3: v.lsax = (v.lsax & 0xF0000u) | value; v.lsaxSet = true; break;
+            case 4: v.nax = (v.nax & 0xFFFFu) | ((value & 0xFu) << 16); break;
+            case 5: v.nax = (v.nax & 0xF0000u) | value; break;
+            }
+            return;
+        }
+        switch (l)
+        {
+        case 0x188u: core.vmixl = (core.vmixl & 0xFF0000u) | value; break;
+        case 0x18Au: core.vmixl = (core.vmixl & 0xFFFFu) | ((value & 0xFFu) << 16); break;
+        case 0x190u: core.vmixr = (core.vmixr & 0xFF0000u) | value; break;
+        case 0x192u: core.vmixr = (core.vmixr & 0xFFFFu) | ((value & 0xFFu) << 16); break;
+        case 0x19Au:
+            core.attr = value;
+            if (value & 0x8000u) // core reset/enable
+                core.statx = 0;
+            break;
+        case 0x19Cu: core.irqa = (core.irqa & 0xFFFFu) | ((value & 0xFu) << 16); break;
+        case 0x19Eu: core.irqa = (core.irqa & 0xF0000u) | value; break;
+        case 0x1A0u: keyOn(core, ci, value); break;
+        case 0x1A2u: keyOn(core, ci, static_cast<uint32_t>(value & 0xFFu) << 16); break;
+        case 0x1A4u: keyOff(core, value); break;
+        case 0x1A6u: keyOff(core, static_cast<uint32_t>(value & 0xFFu) << 16); break;
+        case 0x1A8u: core.tsa = (core.tsa & 0xFFFFu) | ((value & 0xFu) << 16); break;
+        case 0x1AAu: core.tsa = (core.tsa & 0xF0000u) | value; break;
+        case 0x1ACu: // PIO data port
+            m_ram[core.tsa & (kRamWords - 1u)] = value;
+            core.tsa = (core.tsa + 1u) & (kRamWords - 1u);
+            break;
+        case 0x340u: core.endx &= ~static_cast<uint32_t>(value); break;
+        case 0x342u: core.endx &= ~(static_cast<uint32_t>(value & 0xFFu) << 16); break;
+        case 0x344u: core.statx = value; break;
+        default: break;
+        }
+    }
+}
+
+extern "C" void ps2x_spu2_render(int16_t *out, unsigned frames)
+{
+    ps2x::iop::detail::Spu2::instance().render(out, frames);
+}
+
+extern "C" void ps2x_movie_audio_push(const unsigned char *data, unsigned size)
+{
+    static const bool off = std::getenv("SVS_NO_MOVIE_AUDIO") != nullptr;
+    if (off || !data)
+        return;
+    auto &ma = ps2x::iop::detail::movieAudio();
+    std::lock_guard<std::mutex> lock(ma.mutex);
+    ma.push(data, size);
