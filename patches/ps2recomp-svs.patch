+    // Byte range of rows [y0,y1) of a buffer at block base `blockBase` (64-word blocks).
+    Range rowsRange(uint32_t blockBase, uint32_t bw, uint32_t psm, uint32_t y0, uint32_t y1)
+    {
+        uint32_t pw, ph;
+        pageDims(psm, pw, ph);
+        const uint32_t ppr = std::max<uint32_t>(1u, (std::max<uint32_t>(bw, 1u) * 64u + pw - 1u) / pw);
+        const uint32_t base = blockBase * 256u;
+        Range r;
+        r.lo = base + (y0 / ph) * ppr * kPageBytes;
+        r.hi = base + ((y1 + ph - 1u) / ph) * ppr * kPageBytes;
+        r.lo = std::min(r.lo, kVramBytes);
