+// ---- SPU2 (merged here so the patch adds no new files) ----
+#include <atomic>
+#include <mutex>
+#include <thread>
+
+// Minimal SPU2 emulation for the IOP emulator: SPU2 registers, sound RAM,
+// IOP DMA (channels 4/7) and PIO transfers, 2x24 ADPCM voices with ADSR,
+// loop/end flags, IRQ address and a stereo mixer. Audio is produced at 48 kHz
+// by a pacing thread into a ring buffer that the host audio callback drains
+// (see ps2x_spu2_render). Effects (reverb) are not emulated.
+
+
+namespace ps2x::iop::detail
+{
+    class Spu2
+    {
+    public:
+        static Spu2 &instance();
+
+        void reset();
+
+        // 16-bit register access, address is the physical IOP address
+        // (0x1F900000..0x1F9007FF).
+        uint16_t read16(uint32_t address);
+        void write16(uint32_t address, uint16_t value);
+
+        // IOP DMA to SPU RAM (core 0 = channel 4, core 1 = channel 7).
+        void dmaWrite(int core, const uint8_t *data, uint32_t bytes);
+        void dmaRead(int core, uint8_t *data, uint32_t bytes);
+
+        // Pending SPU2 IRQ (IRQA hit) for the IOP interrupt controller.
+        bool takeIrq() { return m_irqPending.exchange(false); }
+
+        // Host side: copy up to frames stereo samples (interleaved int16).
+        void render(int16_t *out, uint32_t frames);
+
+        void start();
+
+    private:
+        Spu2();
+        ~Spu2();
+
+        struct Voice
+        {
+            // registers
+            uint16_t volL = 0, volR = 0, pitch = 0, adsr1 = 0, adsr2 = 0;
+            int32_t gainL = 0, gainR = 0; // fixed volume (sweeps keep the last fixed level)
+            uint32_t ssa = 0, lsax = 0, nax = 0;
+            bool lsaxSet = false;
+            // playback
+            bool on = false;
+            uint32_t pos = 0;         // 12-bit fraction step counter
+            int sampleIndex = 28;     // 0..27 inside current block, 28 = need decode
+            int16_t buf[28]{};
+            int32_t s1 = 0, s2 = 0;   // ADPCM history
+            int16_t prev = 0, cur = 0;
+            uint8_t blockFlags = 0;
+            uint32_t blockAddr = 0;
+            // envelope
+            int phase = 0;            // 0 off, 1 attack, 2 decay, 3 sustain, 4 release
+            int32_t env = 0;
+            int32_t envCounter = 0;
+        };
+
+        struct Core
+        {
+            Voice voices[24];
+            uint32_t tsa = 0;
+            uint32_t irqa = 0;
+            uint16_t attr = 0;
+            uint16_t statx = 0;
+            uint32_t endx = 0;
+            uint32_t vmixl = 0, vmixr = 0;
+            uint16_t mvolL = 0x3FFF, mvolR = 0x3FFF;
+            int32_t mgainL = 0x3FFF, mgainR = 0x3FFF;
+        };
+
+        void keyOn(Core &core, int c, uint32_t mask);
+        void keyOff(Core &core, uint32_t mask);
+        void decodeBlock(Core &core, int c, Voice &v);
+        int16_t nextSample(Core &core, int c, Voice &v);
+        void stepEnvelope(Voice &v);
+        void checkIrq(Core &core, int c, uint32_t wordAddr);
+        void mixFrames(int16_t *out, uint32_t frames);
+        void producerLoop();
+
+        uint16_t &raw(uint32_t offset) { return m_regs[(offset & 0x7FFu) >> 1]; }
+
+        std::mutex m_mutex;
+        std::vector<uint16_t> m_ram;      // 1M words (2 MB)
+        uint16_t m_regs[0x400]{};
+        Core m_cores[2];
+        std::atomic<bool> m_irqPending{false};
+
+        // ring buffer (stereo frames)
+        std::mutex m_ringMutex;
+        std::vector<int16_t> m_ring;
+        size_t m_ringRead = 0, m_ringWrite = 0, m_ringCount = 0;
+        std::thread m_thread;
+        std::atomic<bool> m_quit{false};
+        bool m_started = false;
+    };
+}
