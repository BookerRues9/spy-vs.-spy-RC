+// DMA chains are gathered into a buffer per transfer. Reusing the buffers avoids a
+// malloc and many reallocations (memmove of everything gathered so far) per chain.
+namespace
+{
+    // shared by the game thread (takes buffers) and the GS thread (gives them back)
+    std::mutex s_svsChainPoolMutex;
+    std::vector<std::vector<uint8_t>> s_svsChainPool;
+    std::vector<uint8_t> svsChainAcquire()
+    {
+        {
+            std::lock_guard<std::mutex> lock(s_svsChainPoolMutex);
+            if (!s_svsChainPool.empty())
+            {
+                std::vector<uint8_t> v = std::move(s_svsChainPool.back());
+                s_svsChainPool.pop_back();
+                v.clear();
+                return v;
+            }
+        }
+        std::vector<uint8_t> v;
+        v.reserve(256u * 1024u);
+        return v;
+    }
+    void svsChainRelease(std::vector<uint8_t> &&v)
+    {
+        if (v.capacity() == 0u)
+            return;
+        std::lock_guard<std::mutex> lock(s_svsChainPoolMutex);
+        if (s_svsChainPool.size() < 64u)
+            s_svsChainPool.push_back(std::move(v));
+    }
+}
