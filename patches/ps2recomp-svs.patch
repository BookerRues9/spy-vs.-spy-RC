+// ---------------------------------------------------------------------------
+// Threaded rasterizer: the CPU backend runs on its own thread so the GS raster
+// overlaps with the EE/VU1 work of the game thread. Commands are queued in order;
+// anything that reads results back (presentation, VRAM reads, local->host
+// transfers) waits until the queue is drained. SVS_GS_SYNC=1 disables it.
+// ---------------------------------------------------------------------------
+#include <condition_variable>
+#include <thread>
+#include <deque>
+uint64_t g_svsPixels = 0;
+std::atomic<uint64_t> g_svsGameFrames{0};
+std::atomic<int> g_svsFpsLimit{-1};
+namespace
+{
+// Multi-threaded rasterizer.
+//  * N workers, each with its own GSCpuBackend sharing the same VRAM; worker w
+//    only writes rows with (y/4) % N == w, so draws run in parallel.
+//  * Every worker sees every command, in order.
+//  * Commands that write VRAM outside the row bands (uploads, local->local copies)
+//    run on worker 0 only; the other workers skip them.
+//  * The producer tracks which VRAM was written and sampled since the last barrier;
+//    a command that would read something another worker may not have written yet
+//    (or overwrite something another worker may still read) is marked as a
+//    barrier: it waits until every worker finished all earlier commands.
+//  * Anything that reads results back drains the queue first.
+// One finished game frame = the first strip of the back->front buffer copy (Spy vs Spy).
+// Counts frames for the on-screen fps counter and applies the optional 30 fps cap.
+void svsGameFrameDone()
+{
+    g_svsGameFrames.fetch_add(1, std::memory_order_relaxed);
+    if (g_svsFpsLimit.load(std::memory_order_relaxed) < 0)
+    {
+        // 30 by default (the game's own rate); F4 toggles it, SVS_FPS_LIMIT=0 starts uncapped
+        const char *e = std::getenv("SVS_FPS_LIMIT");
+        g_svsFpsLimit = e ? std::max(0, std::atoi(e)) : 30;
+    }
+    const int limit = g_svsFpsLimit.load(std::memory_order_relaxed);
+    static std::chrono::steady_clock::time_point next{};
+    const auto now = std::chrono::steady_clock::now();
+    if (limit <= 0)
+    {
+        next = now;
+        return;
+    }
+    const auto period = std::chrono::nanoseconds(1000000000LL / limit);
+    if (next == std::chrono::steady_clock::time_point{} || now - next > period * 4)
+        next = now;
+    if (next > now)
+        std::this_thread::sleep_until(next);
+    next += period;
+}
+
+class GSThreadedBackend final : public GSRasterBackend
+{
+public:
+    GSThreadedBackend()
+    {
+        uint32_t n = 1;
+        if (const char *e = std::getenv("SVS_GS_THREADS"))
+            n = static_cast<uint32_t>(std::max(1, std::atoi(e)));
+        else
+        {
+            const uint32_t hw = std::max(1u, std::thread::hardware_concurrency());
+            n = hw >= 6u ? std::min(hw - 2u, 4u) : (hw >= 4u ? 2u : 1u);
+        }
+        m_workers = n;
+        for (uint32_t w = 0; w < n; ++w)
+        {
+            m_inst.push_back(std::make_unique<GSCpuBackend>());
+            m_inst.back()->SetBand(w, n);
+        }
+        m_done.assign(n, 0);
+        s_instance = this;
+        for (uint32_t w = 0; w < n; ++w)
+            m_threads.emplace_back([this, w]() { workerLoop(w); });
+        std::fprintf(stderr, "[gs] rasterizer threads: %u\n", n);
+    }
+    ~GSThreadedBackend() override
+    {
+        if (s_instance == this)
+            s_instance = nullptr;
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_quit = true;
+        }
+        m_cv.notify_all();
+        for (auto &t : m_threads)
+            if (t.joinable())
+                t.join();
+    }
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override
+    {
+        drain();
+        for (auto &b : m_inst) b->Initialize(vram, vramSize);
+    }
+    void Reset() override
+    {
+        drain();
+        for (auto &b : m_inst) b->Reset();
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_dirty.clear();
+        m_reads.clear();
+    }
+
+    void Submit(const GSPrimitiveBatch &batch) override
+    {
+        Cmd c; c.kind = Cmd::Submit; c.batch = batch;
+        push(std::move(c));
+    }
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override
+    {
+        Cmd c; c.kind = Cmd::Clut; c.tex0 = tex0; c.texclut = texclut;
+        push(std::move(c));
+    }
+    void BeginTransfer(const GSTransferCommand &command) override
+    {
+        if (command.direction == 1u) // local -> host: synchronous
+        {
+            drain();
+            single([&]() { m_inst[0]->BeginTransfer(command); });
+            std::lock_guard<std::mutex> l(m_snapMutex);
+            m_snapshot = m_inst[0]->GetTransferSnapshot();
+            return;
+        }
+        Cmd c; c.kind = Cmd::Transfer; c.transfer = command;
+        push(std::move(c));
+    }
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override
+    {
+        Cmd c; c.kind = Cmd::Upload; c.data.assign(data, data + sizeBytes);
+        push(std::move(c));
+    }
+    void Flush() override { Cmd c; c.kind = Cmd::Flush; push(std::move(c)); }
+    void TextureFlush() override { Cmd c; c.kind = Cmd::TexFlush; push(std::move(c)); }
+    void Sync(GSSyncReason reason) override
+    {
+        if (reason == GSSyncReason::Finish)
+        {
+            Cmd c; c.kind = Cmd::SyncFinish; push(std::move(c));
+            return;
+        }
+        drain();
+        m_inst[0]->Sync(reason);
+    }
+    PresentationFrame Present(const GSPresentationRequest &request) override
+    {
+        // Non-blocking: queue a capture after everything drawn so far and hand
+        // back the most recent finished capture (1-2 frames of latency, but the
+        // host thread never waits for the rasterizer).
+        if (std::getenv("SVS_GS_SYNC_PRESENT"))
+        {
+            drain();
+            return m_inst[0]->Present(request);
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_frameMutex);
+            if (m_presentPending)
+                return m_lastFrame; // previous capture not done yet: show the last one
+        }
+        Cmd c; c.kind = Cmd::Present; c.present = request;
+        {
+            std::lock_guard<std::mutex> lock(m_frameMutex);
+            m_presentPending = true;
+        }
+        push(std::move(c));
+        std::lock_guard<std::mutex> lock(m_frameMutex);
+        return m_lastFrame;
+    }
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override
+    {
+        drain();
+        bool r = false;
+        single([&]() { r = m_inst[0]->ClearFramebuffer(context, rgba); });
+        return r;
+    }
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override
+    {
+        drain();
+        return m_inst[0]->ConsumeLocalToHostBytes(dst, maxBytes);
+    }
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override
+    {
+        const_cast<GSThreadedBackend *>(this)->drain();
+        return m_inst[0]->ReadVram(psm, base, bw, x, y);
+    }
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override
+    {
+        drain();
+        m_inst[0]->WriteVram(psm, base, bw, x, y, value);
+    }
+    void SnapshotVram(std::vector<uint8_t> &out) const override
+    {
+        const_cast<GSThreadedBackend *>(this)->drain();
+        m_inst[0]->SnapshotVram(out);
+    }
+    GSTransferSnapshot GetTransferSnapshot() const override
+    {
+        std::lock_guard<std::mutex> lock(m_snapMutex);
+        return m_snapshot;
+    }
+
+    static GSThreadedBackend *s_instance;
+    // Called at every VBlank: the game may only be one vblank ahead of the rasterizer.
+    void vsyncThrottle()
+    {
+        std::unique_lock<std::mutex> lock(m_mutex);
+        // allow the rasterizer to lag up to N vblanks (SVS_GS_LAG, default 2)
+        static const uint32_t lag = std::max(1, std::getenv("SVS_GS_LAG") ? std::atoi(std::getenv("SVS_GS_LAG")) : 2);
+        const uint64_t prev = m_vsyncSeqs[(m_vsyncIdx + 8u - (lag - 1u)) % 8u];
+        m_vsyncIdx = (m_vsyncIdx + 1u) % 8u;
+        m_vsyncSeqs[m_vsyncIdx] = m_pushed;
+        m_lastVsyncSeq = m_pushed;
+        ++m_waiters;
+        m_cv.notify_all();
+        m_cv.wait(lock, [&]() { return minDone() >= prev || m_quit; });
+        --m_waiters;
+    }
+
+private:
+    struct Cmd
+    {
+        enum Kind : uint8_t { Submit, Clut, Transfer, Upload, Flush, TexFlush, SyncFinish, Present } kind = Submit;
+        GSPresentationRequest present{};
+        bool barrier = false;   // wait for all workers to finish earlier commands
+        bool onlyW0 = false;    // only worker 0 executes it; the others skip it
+        GSPrimitiveBatch batch{};
+        GSTex0Reg tex0{};
+        GSTexClutReg texclut{};
+        GSTransferCommand transfer{};
+        std::vector<uint8_t> data;
+    };
+
+    // Run fn on instance 0 with banding disabled (whole-frame operations).
+    template <typename F> void single(F &&fn)
+    {
+        m_inst[0]->SetBand(0, 1);
+        fn();
+        m_inst[0]->SetBand(0, m_workers);
+    }
+
+    struct Range { uint32_t lo, hi; };
+    static uint32_t pageRows(uint32_t psm) { return (psm == 0u || psm == 1u || psm == 0x30u || psm == 0x31u) ? 32u : 64u; }
+    // Producer side ordering decisions (called with m_mutex held).
+    //  m_dirty: VRAM written since the last barrier (draws: all workers; uploads: worker 0)
+    //  m_reads: VRAM sampled as texture/CLUT since the last barrier
+    static bool overlaps(const std::vector<Range> &v, uint32_t lo, uint32_t hi)
+    {
+        for (const Range &r : v)
+            if (lo < r.hi && r.lo < hi)
+                return true;
+        return false;
+    }
+    static void addRange(std::vector<Range> &v, uint32_t lo, uint32_t hi)
+    {
+        for (Range &r : v)
+            if (r.lo == lo) { r.hi = std::max(r.hi, hi); return; }
+        v.push_back({lo, hi});
+    }
+    void setBarrier(Cmd &c)
+    {
+        c.barrier = true;
+        m_dirty.clear();
+        m_reads.clear();
+    }
+    static Range frameRange(uint32_t pageBase, uint32_t width64, uint32_t psm, uint32_t height)
+    {
+        const uint32_t rows = std::max(1u, (height + pageRows(psm) - 1u) / pageRows(psm));
+        const uint32_t lo = pageBase * 32u;
+        return {lo, lo + std::max(1u, width64) * rows * 32u};
+    }
+    static Range blockRange(uint32_t bp, uint32_t bw, uint32_t height)
+    {
+        const uint32_t pages = std::max(1u, bw) * std::max(1u, (height + 31u) / 32u);
+        return {bp, bp + pages * 32u};
+    }
+
+    void classify(Cmd &c)
+    {
+        if (m_workers <= 1u)
+            return;
+        switch (c.kind)
+        {
+        case Cmd::Submit:
+        {
+            const auto &st = c.batch.state;
+            const auto &ctx = st.context;
+            const uint32_t h = static_cast<uint32_t>(ctx.scissor.y1) + 1u;
+            const Range fb = frameRange(ctx.frame.fbp, ctx.frame.fbw, ctx.frame.psm, h);
+            if (st.prim.tme)
+            {
+                const uint32_t texH = 1u << std::min<uint32_t>(ctx.tex0.th, 10u);
+                const Range tex = blockRange(ctx.tex0.tbp0, ctx.tex0.tbw, texH);
+                const bool paletted = (ctx.tex0.psm & 0x7u) >= 3u;
+                const Range clut{ctx.tex0.cbp, ctx.tex0.cbp + 32u};
+                if (overlaps(m_dirty, tex.lo, tex.hi) || (paletted && overlaps(m_dirty, clut.lo, clut.hi)))
+                    setBarrier(c);
+                addRange(m_reads, tex.lo, tex.hi);
+                if (paletted)
+                    addRange(m_reads, clut.lo, clut.hi);
+            }
+            // drawing over something sampled earlier by a lagging worker
+            if (!c.barrier && overlaps(m_reads, fb.lo, fb.hi))
+                setBarrier(c);
+            addRange(m_dirty, fb.lo, fb.hi);
+            if (((ctx.test >> 16) & 1u) != 0u)
+            {
+                const Range z = frameRange(ctx.zbuf.zbp, ctx.frame.fbw, ctx.zbuf.psm, h);
+                addRange(m_dirty, z.lo, z.hi);
+            }
+            break;
+        }
+        case Cmd::Clut:
+            if (overlaps(m_dirty, c.tex0.cbp, c.tex0.cbp + 32u))
+                setBarrier(c);
+            addRange(m_reads, c.tex0.cbp, c.tex0.cbp + 32u);
+            break;
+        case Cmd::Transfer:
+        {
+            c.onlyW0 = true;
+            const auto &bb = c.transfer.bitbltbuf;
+            const uint32_t rows = static_cast<uint32_t>(c.transfer.trxpos.dsay) + static_cast<uint32_t>(c.transfer.trxreg.rrh);
+            m_xferDst = blockRange(bb.dbp, bb.dbw, rows);
+            if (c.transfer.direction == 2u)
+            {
+                const uint32_t srows = static_cast<uint32_t>(c.transfer.trxpos.ssay) + static_cast<uint32_t>(c.transfer.trxreg.rrh);
+                const Range src = blockRange(bb.sbp, bb.sbw, srows);
+                if (overlaps(m_dirty, src.lo, src.hi) || overlaps(m_dirty, m_xferDst.lo, m_xferDst.hi) ||
+                    overlaps(m_reads, m_xferDst.lo, m_xferDst.hi))
+                    setBarrier(c);
+                addRange(m_dirty, m_xferDst.lo, m_xferDst.hi);
+            }
+            break;
+        }
+        case Cmd::Present:
+            c.onlyW0 = true;
+            if (!m_dirty.empty())
+                setBarrier(c);
+            break;
+        case Cmd::Upload:
+            c.onlyW0 = true;
+            if (overlaps(m_reads, m_xferDst.lo, m_xferDst.hi) || overlaps(m_dirty, m_xferDst.lo, m_xferDst.hi))
+                setBarrier(c);
+            addRange(m_dirty, m_xferDst.lo, m_xferDst.hi);
+            break;
+        default:
+            break;
+        }
+    }
+
+    void push(Cmd &&c)
+    {
+        bool wake = false;
+        {
+            std::unique_lock<std::mutex> lock(m_mutex);
+            while (m_pushed - minDone() > 60000u && !m_quit)
+            {
+                ++m_waiters;
+                m_cv.notify_all();
+                m_cv.wait(lock);
+                --m_waiters;
+            }
+            classify(c);
+            if (SVS_ENV_ON("SVS_GSQ_TRACE"))
+            {
+                static uint64_t cmds = 0, barriers = 0, uploads = 0;
+                static auto last = std::chrono::steady_clock::now();
+                ++cmds; barriers += c.barrier ? 1u : 0u; uploads += (c.kind == Cmd::Upload) ? 1u : 0u;
+                const auto now = std::chrono::steady_clock::now();
+                const double el = std::chrono::duration<double>(now - last).count();
+                if (el >= 2.0)
+                {
+                    std::fprintf(stderr, "[svs-gsq] cmds/s=%.0f barriers/s=%.0f uploads/s=%.0f backlog=%llu\n", cmds / el, barriers / el, uploads / el,
+                                 (unsigned long long)(m_pushed - minDone()));
+                    cmds = barriers = uploads = 0; last = now;
+                }
+            }
+            // wake workers only if one of them is idle (avoids a futex per command)
+            for (uint64_t d : m_done)
+                if (d >= m_pushed) { wake = true; break; }
+            if (c.barrier || c.kind == Cmd::SyncFinish)
+                wake = true;
+            m_queue.push_back(std::move(c));
+            ++m_pushed;
+        }
+        if (wake || (m_pushed & 255u) == 0u)
+            m_cv.notify_all();
+    }
+
+    uint64_t minDone() const
+    {
+        uint64_t m = UINT64_MAX;
+        for (uint64_t d : m_done) m = std::min(m, d);
+        return m;
+    }
+
+    void drain()
+    {
+        std::unique_lock<std::mutex> lock(m_mutex);
+        const uint64_t target = m_pushed;
+        m_cv.notify_all();
+        ++m_waiters;
+        m_cv.wait(lock, [&]() { return minDone() >= target || m_quit; });
+        --m_waiters;
+    }
+
+    void execute(uint32_t w, Cmd &c)
+    {
+        GSCpuBackend &b = *m_inst[w];
+        switch (c.kind)
+        {
+        case Cmd::Submit:
+            if (w == 0u && c.batch.state.context.frame.fbp == 0u && c.batch.state.prim.type == 6u && c.batch.state.prim.tme &&
+                c.batch.vertices[0].x < 1.0f && SVS_ENV_ON("SVS_FPS"))
+            {
+                // first strip of the back->front buffer copy = one finished game frame
+                static auto t0 = std::chrono::steady_clock::now();
+                static int frames = 0;
+                ++frames;
+                const auto now = std::chrono::steady_clock::now();
+                const double dt = std::chrono::duration<double>(now - t0).count();
+                if (dt >= 2.0)
+                {
+                    std::fprintf(stderr, "[svs-gamefps] %.1f\n", frames / dt);
+                    frames = 0;
+                    t0 = now;
+                }
+            }
+            b.Submit(c.batch);
+            break;
+        case Cmd::Clut: b.LoadClut(c.tex0, c.texclut); break;
+        case Cmd::Transfer:
+            b.SetBand(0, 1);
+            b.BeginTransfer(c.transfer);
+            b.SetBand(w, m_workers);
+            { std::lock_guard<std::mutex> l(m_snapMutex); m_snapshot = b.GetTransferSnapshot(); }
+            break;
+        case Cmd::Upload:
+            b.UploadImage(c.data.data(), static_cast<uint32_t>(c.data.size()));
+            { std::lock_guard<std::mutex> l(m_snapMutex); m_snapshot = b.GetTransferSnapshot(); }
+            break;
+        case Cmd::Flush: b.Flush(); break;
+        case Cmd::TexFlush: b.TextureFlush(); break;
+        case Cmd::SyncFinish: b.Sync(GSSyncReason::Finish); break;
+        case Cmd::Present:
+        {
+            PresentationFrame f = b.Present(c.present);
+            std::lock_guard<std::mutex> lock(m_frameMutex);
+            if (f)
+                m_lastFrame = std::move(f);
+            m_presentPending = false;
+            break;
+        }
+        }
+    }
+
+    void workerLoop(uint32_t w)
+    {
+        for (;;)
+        {
+            Cmd *c = nullptr;
+            uint64_t idx = 0;
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+                m_cv.wait(lock, [&]() { return m_quit || m_done[w] < m_pushed; });
+                if (m_quit && m_done[w] >= m_pushed)
+                    return;
+                idx = m_done[w];
+                c = &m_queue[idx - m_base];
+                if (c->barrier)
+                {
+                    ++m_waiters;
+                    m_cv.wait(lock, [&]() { return m_quit || minDone() >= idx; });
+                    --m_waiters;
+                }
+            }
+            if (!c->onlyW0 || w == 0u)
+                execute(w, *c);
+            bool notify = false;
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_done[w] = idx + 1u;
+                // free commands every worker has finished
+                const uint64_t md = minDone();
+                while (m_base < md && !m_queue.empty())
+                {
+                    m_queue.pop_front();
+                    ++m_base;
+                }
+                notify = m_waiters > 0 || m_done[w] >= m_pushed || (idx & 63u) == 0u;
+            }
+            if (notify)
+                m_cv.notify_all();
+        }
+    }
+
+    uint32_t m_workers = 1;
+    std::vector<std::unique_ptr<GSCpuBackend>> m_inst;
+    std::vector<std::thread> m_threads;
+    mutable std::mutex m_mutex;
+    std::condition_variable m_cv;
+    std::deque<Cmd> m_queue;
+    uint64_t m_base = 0;
+    uint64_t m_pushed = 0;
+    std::vector<uint64_t> m_done;
+    uint64_t m_lastVsyncSeq = 0;
+    uint64_t m_vsyncSeqs[8] = {};
+    std::mutex m_frameMutex;
+    PresentationFrame m_lastFrame;
+    bool m_presentPending = false;
+    uint32_t m_vsyncIdx = 0;
+    uint32_t m_waiters = 0;
+    bool m_quit = false;
+    std::vector<Range> m_dirty;
+    std::vector<Range> m_reads;
+    Range m_xferDst{0, 0};
+    mutable std::mutex m_snapMutex;
+    GSTransferSnapshot m_snapshot{};
+};
+
+GSThreadedBackend *GSThreadedBackend::s_instance = nullptr;
+
+std::unique_ptr<GSRasterBackend> svsMakeBackend()
+{
+#if defined(PS2X_GL_BACKEND)
+    {
+        const char *r = std::getenv("SVS_RENDERER");
+        if (!(r && std::strcmp(r, "cpu") == 0))
+            return svsMakeGLBackend();
+    }
+#endif
+    if (std::getenv("SVS_GS_SYNC"))
+        return std::make_unique<GSCpuBackend>();
+    return std::make_unique<GSThreadedBackend>();
+}
+}
